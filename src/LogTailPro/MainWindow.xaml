<Window x:Class="LogTailPro.MainWindow"
        x:Name="Root"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LogTailPro.ViewModels"
        xmlns:views="clr-namespace:LogTailPro.Views"
        xmlns:conv="clr-namespace:LogTailPro.Converters"
        xmlns:xcad="https://github.com/Dirkster99/AvalonDock"
        xmlns:themes="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.VS2013"
        mc:Ignorable="d"
        Title="LogTailPro"
        Background="{StaticResource BgBase}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource UiFont}"
        FontSize="{StaticResource UiSize}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.ClearTypeHint="Enabled"
        Height="{Binding Settings.WindowHeight, Mode=TwoWay}"
        Width="{Binding Settings.WindowWidth, Mode=TwoWay}"
        MinWidth="640" MinHeight="400"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:FileStatusColorConverter  x:Key="StatusColorConverter"/>
        <!-- Keyed button/combobox styles live in Themes/Theme.xaml
             so theme-switching works. Window.Resources only holds converters. -->
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="O"    Modifiers="Ctrl"        Command="{Binding OpenFileCommand}"/>
        <KeyBinding Key="W"    Modifiers="Ctrl"        Command="{Binding CloseSelectedTabCommand}"/>
        <KeyBinding Key="F"    Modifiers="Ctrl"        Command="{Binding SelectedTab.ShowSearchCommand}"/>
        <KeyBinding Key="F3"                           Command="{Binding SelectedTab.NextMatchCommand}"/>
        <KeyBinding Key="F3"   Modifiers="Shift"       Command="{Binding SelectedTab.PreviousMatchCommand}"/>
        <KeyBinding Key="Escape"                       Command="{Binding SelectedTab.CloseSearchCommand}"/>
        <KeyBinding Key="End"  Modifiers="Ctrl"        Command="{Binding SelectedTab.ScrollToEndCommand}"/>
        <KeyBinding Key="Home" Modifiers="Ctrl"        Command="{Binding SelectedTab.ScrollToTopCommand}"/>
        <KeyBinding Key="G"    Modifiers="Ctrl"        Command="{Binding SelectedTab.GoToLineCommand}"/>
        <KeyBinding Key="Tab"  Modifiers="Ctrl"        Command="{Binding NextTabCommand}"/>
        <KeyBinding Key="Tab"  Modifiers="Ctrl+Shift"  Command="{Binding PreviousTabCommand}"/>
        <KeyBinding Key="B"    Modifiers="Ctrl"        Command="{Binding SelectedTab.ToggleBookmarkCommand}"/>
        <KeyBinding Key="F2"                           Command="{Binding SelectedTab.NextBookmarkCommand}"/>
        <KeyBinding Key="F2"   Modifiers="Shift"       Command="{Binding SelectedTab.PreviousBookmarkCommand}"/>
        <KeyBinding Key="V"    Modifiers="Ctrl+Shift"  Command="{Binding OpenFromClipboardCommand}"/>
        <KeyBinding Key="P"    Modifiers="Ctrl"        Command="{Binding SelectedTab.PrettyPrintCommand}"/>
        <KeyBinding Key="D1"   Modifiers="Ctrl"        Command="{Binding SelectTabCommand}" CommandParameter="0"/>
        <KeyBinding Key="D2"   Modifiers="Ctrl"        Command="{Binding SelectTabCommand}" CommandParameter="1"/>
        <KeyBinding Key="D3"   Modifiers="Ctrl"        Command="{Binding SelectTabCommand}" CommandParameter="2"/>
        <KeyBinding Key="D4"   Modifiers="Ctrl"        Command="{Binding SelectTabCommand}" CommandParameter="3"/>
        <KeyBinding Key="D5"   Modifiers="Ctrl"        Command="{Binding SelectTabCommand}" CommandParameter="4"/>
        <KeyBinding Key="D6"   Modifiers="Ctrl"        Command="{Binding SelectTabCommand}" CommandParameter="5"/>
        <KeyBinding Key="D7"   Modifiers="Ctrl"        Command="{Binding SelectTabCommand}" CommandParameter="6"/>
        <KeyBinding Key="D8"   Modifiers="Ctrl"        Command="{Binding SelectTabCommand}" CommandParameter="7"/>
        <KeyBinding Key="D9"   Modifiers="Ctrl"        Command="{Binding SelectTabCommand}" CommandParameter="8"/>
        <KeyBinding Key="A"    Modifiers="Ctrl"        Command="{Binding SelectedTab.SelectAllVisibleLinesCommand}"/>
        <KeyBinding Key="C"    Modifiers="Ctrl+Shift"  Command="{Binding SelectedTab.CopyWithLineNumbersCommand}"/>
        <KeyBinding Key="S"    Modifiers="Ctrl+Shift"  Command="{Binding SelectedTab.ToggleStatsPanelCommand}"/>
        <KeyBinding Key="E"    Modifiers="Ctrl+Shift"  Command="{Binding SelectedTab.ToggleElapsedColumnCommand}"/>
        <KeyBinding Key="P"    Modifiers="Ctrl+Shift"  Command="{Binding ToggleProcessExplorerCommand}"/>
    </Window.InputBindings>

    <DockPanel LastChildFill="True">

        <!-- ═══ 1. Menu Bar ════════════════════════════════════════════════════ -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open…"
                          Command="{Binding OpenFileCommand}"
                          InputGestureText="Ctrl+O"/>
                <MenuItem Header="Open from _Clipboard"
                          Command="{Binding OpenFromClipboardCommand}"
                          InputGestureText="Ctrl+Shift+V"/>
                <MenuItem Header="Watch _Directory…"
                          Command="{Binding WatchDirectoryCommand}"/>
                <Separator/>
                <MenuItem Header="Save _Workspace…"
                          Command="{Binding SaveWorkspaceCommand}"/>
                <MenuItem Header="Load Workspace…"
                          Command="{Binding LoadWorkspaceCommand}"/>
                <Separator/>
                <MenuItem Header="Recent Files"
                          ItemsSource="{Binding Settings.RecentFiles}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header"           Value="{Binding}"/>
                            <Setter Property="Command"          Value="{Binding DataContext.OpenRecentFileCommand,
                                    RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Setter Property="CommandParameter" Value="{Binding}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Export Filtered Lines…"
                          Command="{Binding SelectedTab.ExportFilteredLinesCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}"/>
            </MenuItem>

            <MenuItem Header="_Edit">
                <MenuItem Header="_Copy Selected Lines"
                          Command="{Binding SelectedTab.CopySelectedLinesCommand}"
                          InputGestureText="Ctrl+C"/>
                <MenuItem Header="Copy with Line Numbers"
                          Command="{Binding SelectedTab.CopyWithLineNumbersCommand}"
                          InputGestureText="Ctrl+Shift+C"/>
                <MenuItem Header="Select _All"
                          Command="{Binding SelectedTab.SelectAllVisibleLinesCommand}"
                          InputGestureText="Ctrl+A"/>
                <Separator/>
                <MenuItem Header="_Merge All Tabs…"
                          Command="{Binding MergeTabsCommand}"/>
            </MenuItem>

            <MenuItem Header="_View">
                <MenuItem Header="Toggle Follow Tail"
                          Command="{Binding SelectedTab.ToggleFollowTailCommand}"
                          InputGestureText="F"/>
                <MenuItem Header="Go To Line…"
                          Command="{Binding SelectedTab.GoToLineCommand}"
                          InputGestureText="Ctrl+G"/>
                <MenuItem Header="Toggle Line Wrap"
                          Command="{Binding SelectedTab.ToggleLineWrapCommand}"/>
                <Separator/>
                <MenuItem x:Name="PanelsMenu" Header="_Panels" SubmenuOpened="PanelsMenu_SubmenuOpened">
                    <MenuItem Header="Process Explorer" Tag="process" IsCheckable="True" Click="PanelMenuItem_Click" InputGestureText="Ctrl+Shift+P"/>
                    <MenuItem Header="Search"           Tag="search"    IsCheckable="True" Click="PanelMenuItem_Click" InputGestureText="Ctrl+F"/>
                    <MenuItem Header="Search Results"   Tag="results"   IsCheckable="True" Click="PanelMenuItem_Click"/>
                    <MenuItem Header="Stats"            Tag="stats"     IsCheckable="True" Click="PanelMenuItem_Click" InputGestureText="Ctrl+Shift+S"/>
                    <MenuItem Header="Line Details"     Tag="details"   IsCheckable="True" Click="PanelMenuItem_Click"/>
                    <MenuItem Header="Bookmarks"        Tag="bookmarks" IsCheckable="True" Click="PanelMenuItem_Click"/>
                </MenuItem>
                <MenuItem Header="_Reset Layout" Click="ResetLayout_Click"/>
            </MenuItem>

            <MenuItem Header="_Search">
                <MenuItem Header="_Find…"
                          Command="{Binding SelectedTab.ShowSearchCommand}"
                          InputGestureText="Ctrl+F"/>
                <MenuItem Header="Next Match"
                          Command="{Binding SelectedTab.NextMatchCommand}"
                          InputGestureText="F3"/>
                <MenuItem Header="Previous Match"
                          Command="{Binding SelectedTab.PreviousMatchCommand}"
                          InputGestureText="Shift+F3"/>
                <Separator/>
                <MenuItem Header="Toggle Bookmark"
                          Command="{Binding SelectedTab.ToggleBookmarkCommand}"
                          InputGestureText="Ctrl+B"/>
                <MenuItem Header="Next Bookmark"
                          Command="{Binding SelectedTab.NextBookmarkCommand}"
                          InputGestureText="F2"/>
                <MenuItem Header="Previous Bookmark"
                          Command="{Binding SelectedTab.PreviousBookmarkCommand}"
                          InputGestureText="Shift+F2"/>
            </MenuItem>

            <MenuItem Header="_Tools">
                <MenuItem Header="Highlight Rules…"
                          Command="{Binding OpenHighlightRulesCommand}"/>
                <MenuItem Header="Configure Log _Parser…"
                          Command="{Binding OpenLogParserCommand}"/>
                <Separator/>
                <MenuItem Header="Pretty-Print Selected Line"
                          Command="{Binding SelectedTab.PrettyPrintCommand}"
                          InputGestureText="Ctrl+P"/>
                <Separator/>
                <MenuItem Header="Settings…"
                          Command="{Binding OpenSettingsCommand}"/>
            </MenuItem>
        </Menu>

        <!-- ═══ 2. Toolbar ═════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource BgElevated}"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="0,0,0,1"
                Padding="10,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding SelectedTab.FilePathWithSize, Mode=OneWay, FallbackValue=''}"
                           Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           MaxWidth="360" Margin="12,0,0,0"
                           ToolTip="{Binding SelectedTab.FilePathWithSize, Mode=OneWay}"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="📂  Open"
                            Command="{Binding OpenFileCommand}"
                            Style="{StaticResource PrimaryButton}"
                            ToolTip="Open a log file (Ctrl+O)"/>

                    <Rectangle Width="1" Height="22" Fill="{StaticResource BorderNormal}" Margin="10,0"/>

                    <ToggleButton Content="⏬  Follow Tail" Style="{StaticResource ToolbarToggle}" Margin="0,0,6,0"
                                  IsChecked="{Binding SelectedTab.IsFollowTail}"
                                  ToolTip="Auto-scroll to new log lines (F)"/>
                    <ToggleButton Content="🎨  Highlight" Style="{StaticResource ToolbarToggle}" Margin="0,0,6,0"
                                  IsChecked="{Binding IsHighlightingEnabled}"
                                  ToolTip="Apply highlight rules"/>
                    <ToggleButton Content="↩  Wrap" Style="{StaticResource ToolbarToggle}"
                                  IsChecked="{Binding SelectedTab.IsLineWrapEnabled}"
                                  ToolTip="Wrap long lines"/>

                    <Rectangle Width="1" Height="22" Fill="{StaticResource BorderNormal}" Margin="10,0"/>

                    <Button Content="🔍  Search" Style="{StaticResource FlatToolbarButton}" Margin="0,0,6,0" Padding="10,5"
                            Command="{Binding SelectedTab.ShowSearchCommand}"
                            ToolTip="Open search panel (Ctrl+F)"/>
                    <Button Content="🔖  Bookmark" Style="{StaticResource FlatToolbarButton}" Margin="0,0,6,0" Padding="10,5"
                            Command="{Binding SelectedTab.ToggleBookmarkCommand}"
                            ToolTip="Bookmark the selected line (Ctrl+B)"/>
                    <Button Content="⚙  Processes" Style="{StaticResource FlatToolbarButton}" Padding="10,5"
                            Command="{Binding ToggleProcessExplorerCommand}"
                            ToolTip="Toggle Process Explorer (Ctrl+Shift+P)"/>

                    <Rectangle Width="1" Height="22" Fill="{StaticResource BorderNormal}" Margin="10,0"/>

                    <Button Content="⟲  Reset Layout" Style="{StaticResource FlatToolbarButton}" Padding="10,5"
                            Click="ResetLayout_Click"
                            ToolTip="Restore all panels to their default positions"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ 3. Status Bar ══════════════════════════════════════════════════ -->
        <StatusBar DockPanel.Dock="Bottom" Height="28">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage, FallbackValue=Ready}" Foreground="{StaticResource TextSecondary}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding SelectedTab.FileStatus, FallbackValue=''}" Margin="0,0,16,0"
                               Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SelectedTab.TotalLineCount, StringFormat='{}{0:N0} lines', FallbackValue=''}" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding SelectedTab.MatchCount, StringFormat='{}{0:N0} matches', FallbackValue=''}" Margin="0,0,16,0"/>
                    <TextBlock Text="Following" Foreground="{StaticResource StatusGreen}" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTab.IsFollowTail}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- ═══ 4. Docking area + welcome card ═════════════════════════════════ -->
        <Grid>
            <xcad:DockingManager x:Name="Dock"
                                 DocumentsSource="{Binding Tabs}"
                                 AllowMixedOrientation="True"
                                 DocumentClosing="Dock_DocumentClosing"
                                 ActiveContentChanged="Dock_ActiveContentChanged">
                <xcad:DockingManager.Theme>
                    <themes:Vs2013LightTheme/>
                </xcad:DockingManager.Theme>

                <xcad:DockingManager.LayoutItemTemplateSelector>
                    <views:DockItemTemplateSelector>
                        <views:DockItemTemplateSelector.LogTabTemplate>
                            <DataTemplate DataType="{x:Type vm:LogTabViewModel}">
                                <views:LogTabView/>
                            </DataTemplate>
                        </views:DockItemTemplateSelector.LogTabTemplate>
                    </views:DockItemTemplateSelector>
                </xcad:DockingManager.LayoutItemTemplateSelector>

                <xcad:DockingManager.LayoutItemContainerStyleSelector>
                    <views:DockItemStyleSelector>
                        <views:DockItemStyleSelector.DocumentStyle>
                            <Style TargetType="{x:Type xcad:LayoutItem}">
                                <Setter Property="Title"   Value="{Binding Model.FileName}"/>
                                <Setter Property="ToolTip" Value="{Binding Model.FilePathWithSize}"/>
                            </Style>
                        </views:DockItemStyleSelector.DocumentStyle>
                    </views:DockItemStyleSelector>
                </xcad:DockingManager.LayoutItemContainerStyleSelector>

                <xcad:LayoutRoot x:Name="DockLayoutRoot">
                    <xcad:LayoutPanel Orientation="Vertical">

                        <xcad:LayoutPanel Orientation="Horizontal">
                            <!-- Left: Process Explorer -->
                            <xcad:LayoutAnchorablePane DockWidth="300">
                                <xcad:LayoutAnchorable x:Name="ProcessPanel" ContentId="process" Title="Process Explorer" CanClose="True" CanFloat="True">
                                    <views:ProcessExplorerPanel/>
                                </xcad:LayoutAnchorable>
                            </xcad:LayoutAnchorablePane>

                            <!-- Centre: log documents -->
                            <xcad:LayoutDocumentPane/>

                            <!-- Right: details, stats, bookmarks -->
                            <xcad:LayoutAnchorablePane DockWidth="300">
                                <xcad:LayoutAnchorable x:Name="DetailsPanelAnchor" ContentId="details" Title="Line Details">
                                    <views:DetailsPanel/>
                                </xcad:LayoutAnchorable>
                                <xcad:LayoutAnchorable x:Name="StatsPanelAnchor" ContentId="stats" Title="Stats">
                                    <views:StatsPanel/>
                                </xcad:LayoutAnchorable>
                                <xcad:LayoutAnchorable x:Name="BookmarksPanelAnchor" ContentId="bookmarks" Title="Bookmarks">
                                    <views:BookmarksPanel/>
                                </xcad:LayoutAnchorable>
                            </xcad:LayoutAnchorablePane>
                        </xcad:LayoutPanel>

                        <!-- Bottom: search + results -->
                        <xcad:LayoutAnchorablePane DockHeight="210">
                            <xcad:LayoutAnchorable x:Name="SearchPanelAnchor" ContentId="search" Title="Search">
                                <views:SearchPanelView x:Name="SearchView"/>
                            </xcad:LayoutAnchorable>
                            <xcad:LayoutAnchorable x:Name="ResultsPanelAnchor" ContentId="results" Title="Search Results">
                                <views:SearchResultsPanel/>
                            </xcad:LayoutAnchorable>
                        </xcad:LayoutAnchorablePane>

                    </xcad:LayoutPanel>
                </xcad:LayoutRoot>
            </xcad:DockingManager>

            <!-- Welcome card: shown only while no log tab is open -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource BgElevated}"
                    BorderBrush="{StaticResource BorderNormal}" BorderThickness="1" CornerRadius="10"
                    Padding="32,24" MinWidth="380" MaxWidth="560">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Tabs.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="LogTailPro" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                    <TextBlock Text="Open a log file to start tailing it in real time. You can also drag &amp; drop files anywhere on this window."
                               TextWrapping="Wrap" Margin="0,6,0,16" Foreground="{StaticResource TextSecondary}"/>
                    <Button Content="📂  Open a log file…" HorizontalAlignment="Left"
                            Command="{Binding OpenFileCommand}" Style="{StaticResource PrimaryButton}" Padding="16,8"/>
                    <TextBlock Text="RECENT FILES" Margin="0,20,0,6" FontSize="{StaticResource FontSizeSmall}"
                               FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                    <ItemsControl ItemsSource="{Binding Settings.RecentFiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" HorizontalContentAlignment="Left" Margin="0,0,0,4"
                                        Command="{Binding DataContext.OpenRecentFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource FlatToolbarButton}" Padding="10,5"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

    </DockPanel>
</Window>

