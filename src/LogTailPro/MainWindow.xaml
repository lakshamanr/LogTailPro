<Window x:Class="LogTailPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LogTailPro.ViewModels"
        xmlns:views="clr-namespace:LogTailPro.Views"
        xmlns:conv="clr-namespace:LogTailPro.Converters"
        mc:Ignorable="d"
        Title="LogTailPro"
        Height="{Binding Settings.WindowHeight, Mode=TwoWay}"
        Width="{Binding Settings.WindowWidth, Mode=TwoWay}"
        MinWidth="640" MinHeight="400"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:FileStatusColorConverter  x:Key="StatusColorConverter"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="O"   Modifiers="Ctrl"       Command="{Binding OpenFileCommand}"/>
        <KeyBinding Key="W"   Modifiers="Ctrl"       Command="{Binding CloseSelectedTabCommand}"/>
        <KeyBinding Key="F"   Modifiers="Ctrl"       Command="{Binding SelectedTab.ShowSearchCommand}"/>
        <KeyBinding Key="F3"                         Command="{Binding SelectedTab.NextMatchCommand}"/>
        <KeyBinding Key="F3"  Modifiers="Shift"      Command="{Binding SelectedTab.PreviousMatchCommand}"/>
        <KeyBinding Key="Escape"                     Command="{Binding SelectedTab.CloseSearchCommand}"/>
        <KeyBinding Key="End" Modifiers="Ctrl"       Command="{Binding SelectedTab.ScrollToEndCommand}"/>
        <KeyBinding Key="Home" Modifiers="Ctrl"      Command="{Binding SelectedTab.ScrollToTopCommand}"/>
        <KeyBinding Key="G"   Modifiers="Ctrl"       Command="{Binding SelectedTab.GoToLineCommand}"/>
        <KeyBinding Key="Tab" Modifiers="Ctrl"       Command="{Binding NextTabCommand}"/>
        <KeyBinding Key="Tab" Modifiers="Ctrl+Shift" Command="{Binding PreviousTabCommand}"/>
        <KeyBinding Key="B"   Modifiers="Ctrl"       Command="{Binding SelectedTab.ToggleBookmarkCommand}"/>
        <KeyBinding Key="F2"                         Command="{Binding SelectedTab.NextBookmarkCommand}"/>
        <KeyBinding Key="F2"  Modifiers="Shift"      Command="{Binding SelectedTab.PreviousBookmarkCommand}"/>
        <KeyBinding Key="S"   Modifiers="Ctrl+Shift" Command="{Binding SelectedTab.ToggleStatsPanelCommand}"/>
        <KeyBinding Key="V"   Modifiers="Ctrl+Shift" Command="{Binding OpenFromClipboardCommand}"/>
        <KeyBinding Key="D1"  Modifiers="Ctrl"       Command="{Binding SelectTabCommand}" CommandParameter="0"/>
        <KeyBinding Key="D2"  Modifiers="Ctrl"       Command="{Binding SelectTabCommand}" CommandParameter="1"/>
        <KeyBinding Key="D3"  Modifiers="Ctrl"       Command="{Binding SelectTabCommand}" CommandParameter="2"/>
        <KeyBinding Key="D4"  Modifiers="Ctrl"       Command="{Binding SelectTabCommand}" CommandParameter="3"/>
        <KeyBinding Key="D5"  Modifiers="Ctrl"       Command="{Binding SelectTabCommand}" CommandParameter="4"/>
        <KeyBinding Key="D6"  Modifiers="Ctrl"       Command="{Binding SelectTabCommand}" CommandParameter="5"/>
        <KeyBinding Key="D7"  Modifiers="Ctrl"       Command="{Binding SelectTabCommand}" CommandParameter="6"/>
        <KeyBinding Key="D8"  Modifiers="Ctrl"       Command="{Binding SelectTabCommand}" CommandParameter="7"/>
        <KeyBinding Key="D9"  Modifiers="Ctrl"       Command="{Binding SelectTabCommand}" CommandParameter="8"/>
    </Window.InputBindings>

    <DockPanel LastChildFill="True">

        <!-- ═══ Menu Bar ═══ -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open…"
                          Command="{Binding OpenFileCommand}"
                          InputGestureText="Ctrl+O"/>
                <MenuItem Header="Open from _Clipboard"
                          Command="{Binding OpenFromClipboardCommand}"
                          InputGestureText="Ctrl+Shift+V"/>
                <MenuItem Header="Watch _Directory…"
                          Command="{Binding WatchDirectoryCommand}"/>
                <Separator/>
                <MenuItem Header="Recent Files"
                          ItemsSource="{Binding Settings.RecentFiles}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header"           Value="{Binding}"/>
                            <Setter Property="Command"          Value="{Binding DataContext.OpenRecentFileCommand,
                                    RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Setter Property="CommandParameter" Value="{Binding}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Export Filtered Lines…"
                          Command="{Binding SelectedTab.ExportFilteredLinesCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}"/>
            </MenuItem>

            <MenuItem Header="_Edit">
                <MenuItem Header="_Copy Selected Lines"
                          Command="{Binding SelectedTab.CopySelectedLinesCommand}"
                          InputGestureText="Ctrl+C"/>
                <Separator/>
                <MenuItem Header="_Merge All Tabs…"
                          Command="{Binding MergeTabsCommand}"/>
            </MenuItem>

            <MenuItem Header="_View">
                <MenuItem Header="Toggle Follow Tail"
                          Command="{Binding SelectedTab.ToggleFollowTailCommand}"
                          InputGestureText="F"/>
                <MenuItem Header="Go To Line…"
                          Command="{Binding SelectedTab.GoToLineCommand}"
                          InputGestureText="Ctrl+G"/>
                <MenuItem Header="Toggle Elapsed Column"
                          Command="{Binding SelectedTab.ToggleElapsedColumnCommand}"/>
                <MenuItem Header="Toggle Line Wrap"
                          Command="{Binding SelectedTab.ToggleLineWrapCommand}"/>
                <MenuItem Header="Toggle Stats Panel"
                          Command="{Binding SelectedTab.ToggleStatsPanelCommand}"
                          InputGestureText="Ctrl+Shift+S"/>
                <Separator/>
                <MenuItem Header="Tab Position">
                    <MenuItem Header="Top"    Command="{Binding SetTabPlacementCommand}" CommandParameter="Top"/>
                    <MenuItem Header="Bottom" Command="{Binding SetTabPlacementCommand}" CommandParameter="Bottom"/>
                    <MenuItem Header="Left"   Command="{Binding SetTabPlacementCommand}" CommandParameter="Left"/>
                    <MenuItem Header="Right"  Command="{Binding SetTabPlacementCommand}" CommandParameter="Right"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Dark Theme"
                          Command="{Binding SwitchThemeCommand}"
                          CommandParameter="Dark"/>
                <MenuItem Header="Light Theme"
                          Command="{Binding SwitchThemeCommand}"
                          CommandParameter="Light"/>
            </MenuItem>

            <MenuItem Header="_Search">
                <MenuItem Header="_Find…"
                          Command="{Binding SelectedTab.ShowSearchCommand}"
                          InputGestureText="Ctrl+F"/>
                <MenuItem Header="Next Match"
                          Command="{Binding SelectedTab.NextMatchCommand}"
                          InputGestureText="F3"/>
                <MenuItem Header="Previous Match"
                          Command="{Binding SelectedTab.PreviousMatchCommand}"
                          InputGestureText="Shift+F3"/>
                <Separator/>
                <MenuItem Header="Toggle Bookmark"
                          Command="{Binding SelectedTab.ToggleBookmarkCommand}"
                          InputGestureText="Ctrl+B"/>
                <MenuItem Header="Next Bookmark"
                          Command="{Binding SelectedTab.NextBookmarkCommand}"
                          InputGestureText="F2"/>
                <MenuItem Header="Previous Bookmark"
                          Command="{Binding SelectedTab.PreviousBookmarkCommand}"
                          InputGestureText="Shift+F2"/>
            </MenuItem>

            <MenuItem Header="_Tools">
                <MenuItem Header="Highlight Rules…"
                          Command="{Binding OpenHighlightRulesCommand}"/>
                <Separator/>
                <MenuItem Header="Settings…"
                          Command="{Binding OpenSettingsCommand}"/>
            </MenuItem>
        </Menu>

        <!-- ═══ Toolbar ═══ -->
        <ToolBar DockPanel.Dock="Top" Band="1">
            <Button Command="{Binding OpenFileCommand}" ToolTip="Open file (Ctrl+O)" Padding="4">📂</Button>
            <Separator/>
            <ToggleButton IsChecked="{Binding SelectedTab.IsFollowTail}"
                          ToolTip="Follow tail (F)" Padding="4">⬇</ToggleButton>
            <Button Command="{Binding SelectedTab.ShowSearchCommand}"
                    ToolTip="Search (Ctrl+F)" Padding="4">🔍</Button>
            <Button Command="{Binding SelectedTab.GoToLineCommand}"
                    ToolTip="Go to line (Ctrl+G)" Padding="4">#</Button>
            <Separator/>
            <ToggleButton IsChecked="{Binding SelectedTab.IsLineWrapEnabled}"
                          ToolTip="Toggle line wrap" Padding="4">↵</ToggleButton>
            <ToggleButton IsChecked="{Binding SelectedTab.IsStatsPanelVisible}"
                          ToolTip="Stats panel (Ctrl+Shift+S)" Padding="4">📊</ToggleButton>
            <Separator/>
            <Button Command="{Binding SelectedTab.ExportFilteredLinesCommand}"
                    ToolTip="Export filtered lines" Padding="4">💾</Button>
            <Button Command="{Binding SelectedTab.CopySelectedLinesCommand}"
                    ToolTip="Copy selected lines" Padding="4">📋</Button>
            <Separator/>
            <Button Command="{Binding OpenHighlightRulesCommand}"
                    ToolTip="Highlight rules" Padding="4">🎨</Button>
            <Button Command="{Binding OpenSettingsCommand}"
                    ToolTip="Settings" Padding="4">⚙</Button>
        </ToolBar>

        <!-- ═══ Status Bar ═══ -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding SelectedTab.FileName, FallbackValue='No file open'}"
                           FontWeight="SemiBold"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding SelectedTab.StatusText, FallbackValue='Ready'}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding SelectedTab.TotalLineCount,
                                  StringFormat='Lines: {0:N0}',
                                  FallbackValue=''}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding SelectedTab.FileSizeBytes,
                                  StringFormat='Size: {0:N0} bytes',
                                  FallbackValue=''}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding SelectedTab.IsFollowTail,
                                  StringFormat='Follow Tail: {0}',
                                  FallbackValue=''}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ═══ Tab Control ═══ -->
        <TabControl x:Name="MainTabControl"
                    ItemsSource="{Binding Tabs}"
                    SelectedItem="{Binding SelectedTab}"
                    TabStripPlacement="{Binding Settings.TabStripPlacement}"
                    Background="{StaticResource BackgroundBrush}">

            <!-- Tab header template: status icon + filename + close button -->
            <TabControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:LogTabViewModel}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,4,0"
                                MouseMove="TabItem_MouseMove"
                                MouseLeftButtonDown="TabItem_MouseLeftButtonDown"
                                Drop="TabItem_Drop"
                                AllowDrop="True">
                        <TextBlock Text="{Binding FileStatusIcon}"
                                   Foreground="{Binding FileStatus, Converter={StaticResource StatusColorConverter}}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"
                                   FontSize="9"/>
                        <TextBlock Text="{Binding FileName}"
                                   VerticalAlignment="Center"/>
                        <Button Content="✕"
                                Margin="6,0,0,0"
                                Padding="4,0"
                                FontSize="10"
                                VerticalAlignment="Center"
                                Command="{Binding DataContext.CloseTabCommand,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                ToolTip="Close tab"/>
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>

            <!-- Content template: show LogTabView for each tab -->
            <TabControl.ContentTemplate>
                <DataTemplate DataType="{x:Type vm:LogTabViewModel}">
                    <views:LogTabView/>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

    </DockPanel>
</Window>
