<Window x:Class="LogTailPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LogTailPro.ViewModels"
        xmlns:views="clr-namespace:LogTailPro.Views"
        xmlns:conv="clr-namespace:LogTailPro.Converters"
        mc:Ignorable="d"
        Title="LogTailPro"
        Background="{StaticResource BgBase}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource UiFont}"
        FontSize="{StaticResource UiSize}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.ClearTypeHint="Enabled"
        Height="{Binding Settings.WindowHeight, Mode=TwoWay}"
        Width="{Binding Settings.WindowWidth, Mode=TwoWay}"
        MinWidth="640" MinHeight="400"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:FileStatusColorConverter  x:Key="StatusColorConverter"/>
        <!-- Keyed button/combobox styles live in Themes/Dark.xaml and Themes/Light.xaml
             so theme-switching works. Window.Resources only holds converters. -->
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="O"    Modifiers="Ctrl"        Command="{Binding OpenFileCommand}"/>
        <KeyBinding Key="W"    Modifiers="Ctrl"        Command="{Binding CloseSelectedTabCommand}"/>
        <KeyBinding Key="F"    Modifiers="Ctrl"        Command="{Binding SelectedTab.ShowSearchCommand}"/>
        <KeyBinding Key="F3"                           Command="{Binding SelectedTab.NextMatchCommand}"/>
        <KeyBinding Key="F3"   Modifiers="Shift"       Command="{Binding SelectedTab.PreviousMatchCommand}"/>
        <KeyBinding Key="Escape"                       Command="{Binding SelectedTab.CloseSearchCommand}"/>
        <KeyBinding Key="End"  Modifiers="Ctrl"        Command="{Binding SelectedTab.ScrollToEndCommand}"/>
        <KeyBinding Key="Home" Modifiers="Ctrl"        Command="{Binding SelectedTab.ScrollToTopCommand}"/>
        <KeyBinding Key="G"    Modifiers="Ctrl"        Command="{Binding SelectedTab.GoToLineCommand}"/>
        <KeyBinding Key="Tab"  Modifiers="Ctrl"        Command="{Binding NextTabCommand}"/>
        <KeyBinding Key="Tab"  Modifiers="Ctrl+Shift"  Command="{Binding PreviousTabCommand}"/>
        <KeyBinding Key="B"    Modifiers="Ctrl"        Command="{Binding SelectedTab.ToggleBookmarkCommand}"/>
        <KeyBinding Key="F2"                           Command="{Binding SelectedTab.NextBookmarkCommand}"/>
        <KeyBinding Key="F2"   Modifiers="Shift"       Command="{Binding SelectedTab.PreviousBookmarkCommand}"/>
        <KeyBinding Key="V"    Modifiers="Ctrl+Shift"  Command="{Binding OpenFromClipboardCommand}"/>
        <KeyBinding Key="P"    Modifiers="Ctrl"        Command="{Binding SelectedTab.PrettyPrintCommand}"/>
        <KeyBinding Key="D1"   Modifiers="Ctrl"        Command="{Binding SelectTabCommand}" CommandParameter="0"/>
        <KeyBinding Key="D2"   Modifiers="Ctrl"        Command="{Binding SelectTabCommand}" CommandParameter="1"/>
        <KeyBinding Key="D3"   Modifiers="Ctrl"        Command="{Binding SelectTabCommand}" CommandParameter="2"/>
        <KeyBinding Key="D4"   Modifiers="Ctrl"        Command="{Binding SelectTabCommand}" CommandParameter="3"/>
        <KeyBinding Key="D5"   Modifiers="Ctrl"        Command="{Binding SelectTabCommand}" CommandParameter="4"/>
        <KeyBinding Key="D6"   Modifiers="Ctrl"        Command="{Binding SelectTabCommand}" CommandParameter="5"/>
        <KeyBinding Key="D7"   Modifiers="Ctrl"        Command="{Binding SelectTabCommand}" CommandParameter="6"/>
        <KeyBinding Key="D8"   Modifiers="Ctrl"        Command="{Binding SelectTabCommand}" CommandParameter="7"/>
        <KeyBinding Key="D9"   Modifiers="Ctrl"        Command="{Binding SelectTabCommand}" CommandParameter="8"/>
    </Window.InputBindings>

    <DockPanel LastChildFill="True">

        <!-- ═══ 1. Menu Bar ════════════════════════════════════════════════════ -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open…"
                          Command="{Binding OpenFileCommand}"
                          InputGestureText="Ctrl+O"/>
                <MenuItem Header="Open from _Clipboard"
                          Command="{Binding OpenFromClipboardCommand}"
                          InputGestureText="Ctrl+Shift+V"/>
                <MenuItem Header="Watch _Directory…"
                          Command="{Binding WatchDirectoryCommand}"/>
                <Separator/>
                <MenuItem Header="Save _Workspace…"
                          Command="{Binding SaveWorkspaceCommand}"/>
                <MenuItem Header="Load Workspace…"
                          Command="{Binding LoadWorkspaceCommand}"/>
                <Separator/>
                <MenuItem Header="Recent Files"
                          ItemsSource="{Binding Settings.RecentFiles}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header"           Value="{Binding}"/>
                            <Setter Property="Command"          Value="{Binding DataContext.OpenRecentFileCommand,
                                    RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Setter Property="CommandParameter" Value="{Binding}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Export Filtered Lines…"
                          Command="{Binding SelectedTab.ExportFilteredLinesCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}"/>
            </MenuItem>

            <MenuItem Header="_Edit">
                <MenuItem Header="_Copy Selected Lines"
                          Command="{Binding SelectedTab.CopySelectedLinesCommand}"
                          InputGestureText="Ctrl+C"/>
                <Separator/>
                <MenuItem Header="_Merge All Tabs…"
                          Command="{Binding MergeTabsCommand}"/>
            </MenuItem>

            <MenuItem Header="_View">
                <MenuItem Header="Toggle Follow Tail"
                          Command="{Binding SelectedTab.ToggleFollowTailCommand}"
                          InputGestureText="F"/>
                <MenuItem Header="Go To Line…"
                          Command="{Binding SelectedTab.GoToLineCommand}"
                          InputGestureText="Ctrl+G"/>
                <MenuItem Header="Toggle Line Wrap"
                          Command="{Binding SelectedTab.ToggleLineWrapCommand}"/>
                <Separator/>
                <MenuItem Header="Tab Position">
                    <MenuItem Header="Top"    Command="{Binding SetTabPlacementCommand}" CommandParameter="Top"/>
                    <MenuItem Header="Bottom" Command="{Binding SetTabPlacementCommand}" CommandParameter="Bottom"/>
                    <MenuItem Header="Left"   Command="{Binding SetTabPlacementCommand}" CommandParameter="Left"/>
                    <MenuItem Header="Right"  Command="{Binding SetTabPlacementCommand}" CommandParameter="Right"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Dark Theme"
                          Command="{Binding SwitchThemeCommand}"
                          CommandParameter="Dark"/>
                <MenuItem Header="Light Theme"
                          Command="{Binding SwitchThemeCommand}"
                          CommandParameter="Light"/>
            </MenuItem>

            <MenuItem Header="_Search">
                <MenuItem Header="_Find…"
                          Command="{Binding SelectedTab.ShowSearchCommand}"
                          InputGestureText="Ctrl+F"/>
                <MenuItem Header="Next Match"
                          Command="{Binding SelectedTab.NextMatchCommand}"
                          InputGestureText="F3"/>
                <MenuItem Header="Previous Match"
                          Command="{Binding SelectedTab.PreviousMatchCommand}"
                          InputGestureText="Shift+F3"/>
                <Separator/>
                <MenuItem Header="Toggle Bookmark"
                          Command="{Binding SelectedTab.ToggleBookmarkCommand}"
                          InputGestureText="Ctrl+B"/>
                <MenuItem Header="Next Bookmark"
                          Command="{Binding SelectedTab.NextBookmarkCommand}"
                          InputGestureText="F2"/>
                <MenuItem Header="Previous Bookmark"
                          Command="{Binding SelectedTab.PreviousBookmarkCommand}"
                          InputGestureText="Shift+F2"/>
            </MenuItem>

            <MenuItem Header="_Tools">
                <MenuItem Header="Highlight Rules…"
                          Command="{Binding OpenHighlightRulesCommand}"/>
                <MenuItem Header="Configure Log _Parser…"
                          Command="{Binding OpenLogParserCommand}"/>
                <Separator/>
                <MenuItem Header="Pretty-Print Selected Line"
                          Command="{Binding SelectedTab.PrettyPrintCommand}"
                          InputGestureText="Ctrl+P"/>
                <Separator/>
                <MenuItem Header="Settings…"
                          Command="{Binding OpenSettingsCommand}"/>
            </MenuItem>
        </Menu>

        <!-- ═══ 2. Toolbar ═════════════════════════════════════════════════════ -->
        <ToolBar DockPanel.Dock="Top"
                 Background="{StaticResource BgElevated}"
                 BorderBrush="{StaticResource BorderSubtle}"
                 BorderThickness="0,0,0,1"
                 Height="28"
                 Loaded="ToolBar_Loaded">

            <Button Content="Open"
                    Command="{Binding OpenFileCommand}"
                    Style="{StaticResource FlatToolbarButton}"
                    ToolTip="Open file (Ctrl+O)"/>

            <Separator/>

            <CheckBox Content="Highlighting"
                      IsChecked="{Binding IsHighlightingEnabled}"
                      Foreground="{StaticResource TextPrimary}"
                      VerticalAlignment="Center"
                      FontFamily="Segoe UI"
                      FontSize="11"/>

            <CheckBox Content="Follow_Tail"
                      IsChecked="{Binding SelectedTab.IsFollowTail}"
                      Foreground="{StaticResource TextPrimary}"
                      Margin="8,0,0,0"
                      VerticalAlignment="Center"
                      FontFamily="Segoe UI"
                      FontSize="11"
                      ToolTip="Auto-scroll to new log lines (F)"/>

            <ComboBox Width="58"
                      Style="{StaticResource DarkComboBox}"
                      VerticalAlignment="Center"
                      Margin="8,0,0,0"
                      SelectedIndex="1"
                      ToolTip="Text encoding">
                <ComboBoxItem Content="ANSI"/>
                <ComboBoxItem Content="UTF-8"/>
                <ComboBoxItem Content="UTF-16"/>
                <ComboBoxItem Content="ASCII"/>
            </ComboBox>

            <TextBox IsReadOnly="True"
                     Text="{Binding SelectedTab.FilePathWithSize, Mode=OneWay, FallbackValue=''}"
                     Background="{StaticResource BgInput}"
                     Foreground="{StaticResource TextSecondary}"
                     BorderBrush="{StaticResource BorderSubtle}"
                     BorderThickness="1"
                     Padding="4,2"
                     FontFamily="Segoe UI"
                     FontSize="11"
                     Width="340"
                     Margin="6,0,0,0"
                     VerticalContentAlignment="Center"/>
        </ToolBar>

        <!-- ═══ 3. Tab Strip (headers only — content shown by ContentControl) ═ -->
        <TabControl DockPanel.Dock="Top"
                    ItemsSource="{Binding Tabs}"
                    SelectedItem="{Binding SelectedTab}"
                    TabStripPlacement="{Binding Settings.TabStripPlacement}"
                    Background="{StaticResource BgTabActive}"
                    BorderBrush="{StaticResource BorderNormal}"
                    BorderThickness="0,0,0,1"
                    Padding="0">

            <!-- Custom template: renders only the tab header panel, no content area -->
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <TabPanel IsItemsHost="True"
                                  Background="{TemplateBinding Background}"/>
                    </Border>
                </ControlTemplate>
            </TabControl.Template>

            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Grid x:Name="root"
                                      MinWidth="80" MaxWidth="210"
                                      MouseMove="TabItem_MouseMove"
                                      MouseLeftButtonDown="TabItem_MouseLeftButtonDown"
                                      Drop="TabItem_Drop"
                                      AllowDrop="True">
                                    <Border x:Name="border"
                                            Background="{StaticResource BgTabInactive}"
                                            BorderBrush="{StaticResource BorderNormal}"
                                            BorderThickness="1,1,1,0"
                                            Padding="8,0,4,0">
                                        <StackPanel Orientation="Horizontal"
                                                    Height="22"
                                                    VerticalAlignment="Center">
                                            <!-- Status dot -->
                                            <Ellipse Width="6" Height="6"
                                                     Margin="0,0,5,0"
                                                     Fill="{Binding FileStatus,
                                                            Converter={StaticResource StatusColorConverter}}"/>
                                            <!-- File name -->
                                            <TextBlock x:Name="label"
                                                       Text="{Binding FileName}"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontFamily="Segoe UI"
                                                       FontSize="11"
                                                       MaxWidth="140"/>
                                            <!-- Close button — always visible per spec -->
                                            <Button Content="x"
                                                    Margin="5,0,0,0"
                                                    Width="14" Height="14"
                                                    FontSize="9"
                                                    Foreground="{StaticResource TextSecondary}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.CloseTabCommand,
                                                             RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Close tab (Ctrl+W)"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="border" Property="Background"  Value="{StaticResource BgTabActive}"/>
                                        <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                        <Setter TargetName="label"  Property="Foreground"  Value="{StaticResource TextPrimary}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{StaticResource BgTabHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.ItemContainerStyle>

        </TabControl>

        <!-- ═══ 4. Search Results — BOTTOM (declared first so it sits below search bar) -->
        <ListView DockPanel.Dock="Bottom"
                  ItemsSource="{Binding SelectedTab.SearchResults}"
                  Background="{StaticResource BgBase}"
                  Foreground="{StaticResource TextResults}"
                  BorderBrush="{StaticResource BorderNormal}"
                  BorderThickness="0,1,0,0"
                  FontFamily="Consolas"
                  FontSize="12"
                  MaxHeight="150"
                  Visibility="{Binding SelectedTab.IsSearchResultsVisible,
                               Converter={StaticResource BoolToVisibility}}">

            <ListView.Resources>
                <!-- Compact header style (6,2 padding to fit the 150px MaxHeight budget) -->
                <Style TargetType="GridViewColumnHeader">
                    <Setter Property="Background"               Value="{StaticResource BgSurface}"/>
                    <Setter Property="Foreground"               Value="{StaticResource TextSecondary}"/>
                    <Setter Property="BorderBrush"              Value="{StaticResource BorderNormal}"/>
                    <Setter Property="BorderThickness"          Value="0,0,1,1"/>
                    <Setter Property="Padding"                  Value="6,2"/>
                    <Setter Property="FontFamily"               Value="Segoe UI"/>
                    <Setter Property="FontSize"                 Value="11"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                </Style>
            </ListView.Resources>

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding"         Value="0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Background"      Value="Transparent"/>
                    <Setter Property="Foreground"      Value="{StaticResource TextResults}"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource BgOverlay}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource BgElevated}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Line" Width="60">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LineNumber}"
                                           TextAlignment="Right"
                                           Foreground="#888899"
                                           FontFamily="Consolas"
                                           FontSize="12"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Text" Width="2000">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- ═══ 5. Search Bar — BOTTOM (above results) ═════════════════════════ -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource BgElevated}"
                BorderBrush="{StaticResource BorderNormal}"
                BorderThickness="0,1,0,0"
                Height="30"
                Visibility="{Binding SelectedTab.IsSearchPanelVisible,
                             Converter={StaticResource BoolToVisibility}}">

            <DockPanel Margin="4,0" LastChildFill="False">

                <!-- Left side -->
                <ComboBox DockPanel.Dock="Left"
                          Width="52"
                          SelectedIndex="{Binding SelectedTab.IsRegexModeIndex, Mode=TwoWay}"
                          Style="{StaticResource DarkComboBox}"
                          VerticalAlignment="Center"
                          Margin="0,0,3,0">
                    <ComboBoxItem Content="Text"/>
                    <ComboBoxItem Content="Regex"/>
                </ComboBox>

                <TextBox DockPanel.Dock="Left"
                         Width="160"
                         Text="{Binding SelectedTab.SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Background="{StaticResource BgInput}"
                         Foreground="{StaticResource TextPrimary}"
                         CaretBrush="{StaticResource TextPrimary}"
                         BorderBrush="{StaticResource BorderNormal}"
                         BorderThickness="1"
                         Padding="4,2"
                         FontFamily="Consolas"
                         FontSize="12"
                         VerticalContentAlignment="Center"
                         VerticalAlignment="Center"
                         Margin="0,0,3,0"/>

                <Button DockPanel.Dock="Left"
                        Content="Search"
                        Command="{Binding SelectedTab.ExecuteSearchCommand}"
                        Style="{StaticResource FlatSearchButton}"
                        Margin="0,0,3,0"/>

                <Button DockPanel.Dock="Left"
                        Content="Stop"
                        Command="{Binding SelectedTab.StopSearchCommand}"
                        Style="{StaticResource FlatToolbarButton}"
                        Margin="0,0,3,0"/>

                <Button DockPanel.Dock="Left"
                        Content="Pause"
                        Command="{Binding SelectedTab.PauseSearchCommand}"
                        Style="{StaticResource FlatToolbarButton}"
                        Margin="0,0,3,0"/>

                <Button DockPanel.Dock="Left"
                        Content="Clear"
                        Command="{Binding SelectedTab.ClearSearchCommand}"
                        Style="{StaticResource FlatToolbarButton}"
                        Margin="0,0,8,0"/>

                <CheckBox DockPanel.Dock="Left"
                          Content="Filter Tail"
                          IsChecked="{Binding SelectedTab.IsFilterTailMode}"
                          Foreground="{StaticResource TextPrimary}"
                          FontFamily="Segoe UI"
                          FontSize="11"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0"/>

                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding SelectedTab.MatchCount, StringFormat='Found {0} matching lines.'}"
                           Foreground="{StaticResource TextSecondary}"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           VerticalAlignment="Center"/>

                <!-- Right side (order is right-to-left for DockPanel.Dock="Right") -->
                <Button DockPanel.Dock="Right"
                        Content="Add"
                        Command="{Binding SelectedTab.AddSavedPatternCommand}"
                        Background="#0078D4"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="8,3"
                        FontFamily="Segoe UI"
                        FontSize="11"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        Margin="0,0,0,0"/>

                <CheckBox DockPanel.Dock="Right"
                          Content="Invert Mat."
                          IsChecked="{Binding SelectedTab.IsInvertMatch}"
                          Foreground="{StaticResource TextPrimary}"
                          FontFamily="Segoe UI"
                          FontSize="11"
                          VerticalAlignment="Center"
                          Margin="0,0,6,0"/>

                <CheckBox DockPanel.Dock="Right"
                          Content="Ignore Case"
                          IsChecked="{Binding SelectedTab.IsIgnoreCase}"
                          Foreground="{StaticResource TextPrimary}"
                          FontFamily="Segoe UI"
                          FontSize="11"
                          VerticalAlignment="Center"
                          Margin="0,0,6,0"/>

                <CheckBox DockPanel.Dock="Right"
                          Content="Regex Syntax"
                          IsChecked="{Binding SelectedTab.IsRegexMode}"
                          Foreground="{StaticResource TextPrimary}"
                          FontFamily="Segoe UI"
                          FontSize="11"
                          VerticalAlignment="Center"
                          Margin="0,0,6,0"/>

            </DockPanel>
        </Border>

        <!-- ═══ 6. Log Content — fills remaining space (LastChild) ═════════════ -->
        <ContentControl Content="{Binding SelectedTab}">
            <ContentControl.ContentTemplate>
                <DataTemplate DataType="{x:Type vm:LogTabViewModel}">
                    <views:LogTabView/>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

    </DockPanel>
</Window>
