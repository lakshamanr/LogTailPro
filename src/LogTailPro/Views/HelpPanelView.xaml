<UserControl x:Class="LogTailPro.Views.HelpPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LogTailPro.Converters"
             xmlns:models="clr-namespace:LogTailPro.Models"
             xmlns:vm="clr-namespace:LogTailPro.ViewModels"
             Background="{StaticResource BgSurface}"
             MinWidth="220">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">

        <!-- ══ Top Navigation & Filter Bar ═════════════════════════════════════ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BgElevated}"
                BorderBrush="{StaticResource BorderNormal}" BorderThickness="0,0,0,1"
                Padding="8,6">
            <StackPanel>
                <!-- View Mode Switch: Topics List vs Topic Details -->
                <DockPanel LastChildFill="True" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="↗ Pop Out"
                            Click="PopOut_Click"
                            Style="{StaticResource FlatToolbarButton}"
                            Padding="6,2" FontSize="11"
                            ToolTip="Open Help Guide in a separate dialog window"/>

                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RbTopics" Content="Topics"
                                     IsChecked="True"
                                     Style="{StaticResource {x:Type RadioButton}}"
                                     Margin="0,0,12,0" VerticalAlignment="Center"
                                     Checked="ViewMode_Changed"/>
                        <RadioButton x:Name="RbDetails" Content="Topic Details"
                                     Style="{StaticResource {x:Type RadioButton}}"
                                     VerticalAlignment="Center"
                                     Checked="ViewMode_Changed"/>
                    </StackPanel>
                </DockPanel>

                <!-- Category Selector -->
                <ComboBox ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                          Style="{StaticResource DarkComboBox}"
                          Padding="6,3" Margin="0,0,0,6"/>

                <!-- Search Box -->
                <Grid>
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource BgInput}"
                             Foreground="{StaticResource TextPrimary}"
                             CaretBrush="{StaticResource TextPrimary}"
                             BorderBrush="{StaticResource BorderNormal}"
                             BorderThickness="1" Padding="6,3"
                             FontFamily="{StaticResource UiFont}"
                             FontSize="{StaticResource FontSizeBody}"
                             ToolTip="Filter help topics by name, shortcut, or keywords…"/>
                    <TextBlock Text="Filter help topics…"
                               IsHitTestVisible="False"
                               Foreground="{StaticResource TextMuted}"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="{StaticResource FontSizeBody}"
                               VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ══ Bottom Quick Action Bar ═════════════════════════════════════════ -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BgElevated}"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0"
                Padding="6,4">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Left" Content="📋 Copy Topic"
                        Command="{Binding CopyTopicDetailsCommand}"
                        Style="{StaticResource FlatToolbarButton}"
                        Padding="6,2" FontSize="11"
                        ToolTip="Copy selected topic details to clipboard"/>

                <Button DockPanel.Dock="Right" Content="📄 Markdown"
                        Command="{Binding OpenMarkdownGuideCommand}"
                        Style="{StaticResource FlatToolbarButton}"
                        Padding="6,2" FontSize="11"
                        ToolTip="Open HELP_GUIDE.md in default editor"/>

                <TextBlock Text="{Binding FilteredTopics.Count, StringFormat='{}{0} topics'}"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="10" VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ══ Main Content Area (Topics List OR Topic Details) ════════════════ -->
        <Grid>
            <!-- ── 1. Topics List View ── -->
            <ListBox x:Name="TopicsListBox"
                     ItemsSource="{Binding FilteredTopics}"
                     SelectedItem="{Binding SelectedTopic, Mode=TwoWay}"
                     Background="{StaticResource BgBase}"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="TopicsListBox_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:HelpTopic}">
                        <DockPanel LastChildFill="True">
                            <!-- Shortcut Pill -->
                            <Border DockPanel.Dock="Right"
                                    Visibility="{Binding HasShortcut, Converter={StaticResource BoolToVisibility}}"
                                    Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}"
                                    BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="4,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Shortcut}" Foreground="{StaticResource Accent}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="SemiBold"/>
                            </Border>

                            <!-- Title & Category -->
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding ShortTitle}" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Category}" FontSize="10"
                                           Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- ── 2. Topic Details View ── -->
            <ScrollViewer x:Name="DetailsScrollViewer"
                          Visibility="Collapsed"
                          Background="{StaticResource BgElevated}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="10,8">
                <StackPanel>
                    <!-- Back Button & Header -->
                    <DockPanel LastChildFill="True" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Left" Content="◀ All Topics"
                                Click="BackToTopics_Click"
                                Style="{StaticResource FlatToolbarButton}"
                                Padding="6,2" FontSize="11" Margin="0,0,8,0"/>

                        <Border DockPanel.Dock="Right"
                                Visibility="{Binding SelectedTopic.HasShortcut, Converter={StaticResource BoolToVisibility}}"
                                Background="{StaticResource AccentMuted}" BorderBrush="{StaticResource Accent}"
                                BorderThickness="1" CornerRadius="3" Padding="6,2">
                            <TextBlock Text="{Binding SelectedTopic.Shortcut}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource Accent}"/>
                        </Border>

                        <TextBlock Text="{Binding SelectedTopic.ShortTitle}"
                                   FontWeight="Bold" Foreground="{StaticResource TextPrimary}"
                                   FontSize="{StaticResource FontSizeSubtitle}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <!-- Location info -->
                    <Border Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}"
                            BorderThickness="1" CornerRadius="3" Padding="8,5" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedTopic.Category}" Foreground="{StaticResource Accent}"
                                       FontSize="10" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedTopic.UiLocation}" Foreground="{StaticResource TextSecondary}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Overview -->
                    <TextBlock Text="Overview" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{StaticResource TextPrimary}" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding SelectedTopic.Overview}" Foreground="{StaticResource TextSecondary}"
                               TextWrapping="Wrap" FontSize="{StaticResource FontSizeSmall}" Margin="0,0,0,12"/>

                    <!-- Demo Scenario -->
                    <Border Background="{StaticResource BgBase}" BorderBrush="{StaticResource BorderNormal}"
                            BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="💡 Demo Scenario" FontWeight="SemiBold"
                                       Foreground="{StaticResource Accent}" FontSize="11" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding SelectedTopic.DemoScenario}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="11"
                                       Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Step-by-Step Instructions -->
                    <TextBlock Text="How to Use" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{StaticResource TextPrimary}" Margin="0,0,0,2"/>
                    <Border Background="{StaticResource BgBase}" BorderBrush="{StaticResource BorderSubtle}"
                            BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,12">
                        <TextBlock Text="{Binding SelectedTopic.StepByStep}" Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap" FontSize="{StaticResource FontSizeSmall}"/>
                    </Border>

                    <!-- Under The Hood -->
                    <TextBlock Text="Under The Hood" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{StaticResource TextPrimary}" Margin="0,0,0,2"/>
                    <Border Background="{StaticResource BgBase}" BorderBrush="{StaticResource BorderSubtle}"
                            BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,8">
                        <TextBlock Text="{Binding SelectedTopic.UnderTheHood}" Foreground="{StaticResource TextMuted}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="10" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

    </DockPanel>
</UserControl>
