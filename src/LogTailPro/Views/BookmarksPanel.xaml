<UserControl x:Class="LogTailPro.Views.BookmarksPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LogTailPro.Converters"
             Background="{StaticResource BgElevated}">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>
    <Grid>
        <TextBlock Text="No bookmarks yet. Select a line and press Ctrl+B."
                   Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="12" VerticalAlignment="Top">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTab.Bookmarks.Count, FallbackValue=0}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <ListView ItemsSource="{Binding SelectedTab.Bookmarks}"
                  SelectedItem="{Binding SelectedTab.SelectedLogLine, Mode=TwoWay}"
                  Background="Transparent"
                  FontFamily="{StaticResource MonoFont}"
                  FontSize="{StaticResource FontSizeMonoSmall}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="4,2">
                        <TextBlock Text="{Binding LineNumber}" Width="56" TextAlignment="Right" Foreground="{StaticResource Accent}" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" MaxWidth="600"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
