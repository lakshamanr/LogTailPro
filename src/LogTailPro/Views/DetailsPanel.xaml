<UserControl x:Class="LogTailPro.Views.DetailsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LogTailPro.Converters"
             xmlns:models="clr-namespace:LogTailPro.Models"
             Background="{StaticResource BgElevated}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>

        <HierarchicalDataTemplate DataType="{x:Type models:LogPropertyNode}" ItemsSource="{Binding Children}">
            <Border Padding="3,2" Margin="0,1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                               FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeMonoSmall}"/>
                    <TextBlock Text=" : " Foreground="{StaticResource TextMuted}"
                               FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeMonoSmall}"/>
                    <Border CornerRadius="2" Background="{StaticResource BgSurface}" Padding="3,0" Margin="2,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Type}" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                    </Border>
                    <TextBlock Text="{Binding Value}" Foreground="{StaticResource TextPrimary}"
                               FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeMonoSmall}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- Empty state placeholder -->
        <TextBlock Text="Select a log line in any open tab to inspect its structured properties and raw content."
                   Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="16"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                   Visibility="{Binding SelectedTab.SelectedLogLine, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse, FallbackValue=Visible}"/>

        <!-- Line inspector content -->
        <DockPanel LastChildFill="True"
                   Visibility="{Binding SelectedTab.SelectedLogLine, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}">

            <!-- 1. Header card (Level, Timestamp, Message, Template, Exception) -->
            <Border DockPanel.Dock="Top" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="0,0,0,1" Padding="12,10">
                <StackPanel>
                    <!-- Top row: Level badge + Timestamp -->
                    <DockPanel LastChildFill="True" Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedTab.SelectedLineTimestamp}"
                                   Foreground="{StaticResource TextMuted}" FontFamily="{StaticResource MonoFont}"
                                   FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"/>

                        <Border CornerRadius="3" Padding="6,2" Margin="0,0,8,0" HorizontalAlignment="Left"
                                Visibility="{Binding SelectedTab.SelectedLineLevel, Converter={StaticResource StringNotEmptyToVisibility}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource BadgeInfoBg}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTab.SelectedLineLevel}" Value="Information">
                                            <Setter Property="Background" Value="{StaticResource BadgeInfoBg}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedTab.SelectedLineLevel}" Value="Warning">
                                            <Setter Property="Background" Value="{StaticResource BadgeWarnBg}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedTab.SelectedLineLevel}" Value="Error">
                                            <Setter Property="Background" Value="{StaticResource BadgeErrorBg}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedTab.SelectedLineLevel}" Value="Fatal">
                                            <Setter Property="Background" Value="{StaticResource BadgeFatalBg}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedTab.SelectedLineLevel}" Value="Debug">
                                            <Setter Property="Background" Value="{StaticResource BadgeDebugBg}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedTab.SelectedLineLevel}" Value="Verbose">
                                            <Setter Property="Background" Value="{StaticResource BadgeDebugBg}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding SelectedTab.SelectedLineLevel}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeSmall}" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource BadgeInfoFg}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTab.SelectedLineLevel}" Value="Information">
                                                <Setter Property="Foreground" Value="{StaticResource BadgeInfoFg}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedTab.SelectedLineLevel}" Value="Warning">
                                                <Setter Property="Foreground" Value="{StaticResource BadgeWarnFg}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedTab.SelectedLineLevel}" Value="Error">
                                                <Setter Property="Foreground" Value="{StaticResource BadgeErrorFg}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedTab.SelectedLineLevel}" Value="Fatal">
                                                <Setter Property="Foreground" Value="{StaticResource BadgeFatalFg}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedTab.SelectedLineLevel}" Value="Debug">
                                                <Setter Property="Foreground" Value="{StaticResource BadgeDebugFg}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedTab.SelectedLineLevel}" Value="Verbose">
                                                <Setter Property="Foreground" Value="{StaticResource BadgeDebugFg}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </DockPanel>

                    <!-- Rendered Message -->
                    <TextBlock Text="{Binding SelectedTab.SelectedLineMessage}"
                               Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"
                               FontSize="{StaticResource FontSizeSubtitle}" TextWrapping="Wrap" Margin="0,0,0,4"/>

                    <!-- Message Template (clearly distinct from rendered message) -->
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,4"
                                Visibility="{Binding SelectedTab.HasSelectedLineTemplate, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Template: " Foreground="{StaticResource TextMuted}" FontSize="11" FontStyle="Italic"/>
                        <TextBlock Text="{Binding SelectedTab.SelectedLineTemplate}" Foreground="{StaticResource TextSecondary}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Malformed JSON banner -->
                    <Border Background="{StaticResource BgWarningBanner}" BorderBrush="{StaticResource TextWarningBanner}"
                            BorderThickness="1" CornerRadius="3" Padding="6,4" Margin="0,4,0,0"
                            Visibility="{Binding SelectedTab.SelectedStructuredEvent.ParseError, Converter={StaticResource StringNotEmptyToVisibility}}">
                        <TextBlock Text="{Binding SelectedTab.SelectedStructuredEvent.ParseError}"
                                   Foreground="{StaticResource TextWarningBanner}" FontSize="11" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Exception section -->
                    <Border Background="{StaticResource BadgeErrorBg}" BorderBrush="{StaticResource BadgeErrorFg}"
                            BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,6,0,0"
                            Visibility="{Binding SelectedTab.HasSelectedLineException, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel LastChildFill="True">
                            <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Content="Copy Exception" Style="{StaticResource FlatToolbarButton}"
                                        Padding="6,2" FontSize="11" Command="{Binding SelectedTab.CopyExceptionCommand}"/>
                                <TextBlock Text="Exception" Foreground="{StaticResource BadgeErrorFg}" FontWeight="Bold" FontSize="11"/>
                            </DockPanel>
                            <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <TextBox Text="{Binding SelectedTab.SelectedLineException, Mode=OneWay}"
                                         IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                         Foreground="{StaticResource BadgeErrorFg}" FontFamily="{StaticResource MonoFont}"
                                         FontSize="{StaticResource FontSizeMonoSmall}" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 2. Body tabs: Properties Tree vs Raw Text -->
            <TabControl Background="{StaticResource BgElevated}" BorderThickness="0">
                <TabItem Header="Properties">
                    <Grid>
                        <TextBlock Text="No custom structured properties on this record."
                                   Foreground="{StaticResource TextMuted}" Margin="12"
                                   Visibility="{Binding SelectedTab.SelectedLineProperties.Count, Converter={StaticResource StringNotEmptyToVisibility}, ConverterParameter=Inverse, FallbackValue=Collapsed}"/>
                        <TreeView ItemsSource="{Binding SelectedTab.SelectedLineProperties}"
                                  Background="{StaticResource BgLog}" BorderThickness="0"
                                  Padding="6" VirtualizingPanel.IsVirtualizing="True">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="True"/>
                                    <Setter Property="Padding" Value="2"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>
                    </Grid>
                </TabItem>
                <TabItem Header="Raw Text">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Top" Background="{StaticResource BgSurface}" Padding="8,4" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
                            <Button HorizontalAlignment="Right" Content="Copy Raw Text" Style="{StaticResource FlatToolbarButton}"
                                    Padding="8,3" FontSize="11" Command="{Binding SelectedTab.CopyDetailTextCommand}"/>
                        </Border>
                        <TextBox Text="{Binding SelectedTab.DetailText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 FontFamily="{StaticResource MonoFont}"
                                 FontSize="{StaticResource FontSizeMonoSmall}"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Background="{StaticResource BgLog}"
                                 Foreground="{StaticResource TextLog}"
                                 BorderThickness="0"
                                 Padding="10"/>
                    </DockPanel>
                </TabItem>
            </TabControl>

        </DockPanel>
    </Grid>
</UserControl>
