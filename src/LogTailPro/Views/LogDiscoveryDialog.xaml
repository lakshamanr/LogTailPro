<Window x:Class="LogTailPro.Views.LogDiscoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open Log Files"
        Background="{StaticResource BgBase}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource UiFont}"
        FontSize="{StaticResource UiSize}"
        Width="900" Height="440"
        MinWidth="640" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}"
                       Foreground="{StaticResource TextPrimary}"
                       FontSize="{StaticResource FontSizeHeading}"
                       FontWeight="SemiBold"/>
            <TextBlock Margin="0,4,0,0"
                       Foreground="{StaticResource TextSecondary}"
                       Text="★ marks the most likely main log of each process. Tick the files to open — each opens in its own tab."
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Candidates -->
        <ListView Grid.Row="2"
                  ItemsSource="{Binding ItemsView}"
                  Background="{StaticResource BgBase}"
                  Foreground="{StaticResource TextPrimary}"
                  BorderBrush="{StaticResource BorderNormal}"
                  BorderThickness="1"
                  SelectionMode="Single"
                  MouseDoubleClick="List_MouseDoubleClick">

            <ListView.Resources>
                <Style TargetType="GridViewColumnHeader">
                    <Setter Property="Background"      Value="{StaticResource BgSurface}"/>
                    <Setter Property="Foreground"      Value="{StaticResource TextSecondary}"/>
                    <Setter Property="BorderBrush"     Value="{StaticResource BorderNormal}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="Padding"         Value="8,4"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                </Style>
            </ListView.Resources>

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding"         Value="0,2"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Background"      Value="Transparent"/>
                    <Setter Property="Foreground"      Value="{StaticResource TextPrimary}"/>
                    <Setter Property="ToolTip"         Value="{Binding Candidate.Detail}"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource BgOverlay}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource BgElevated}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontWeight="SemiBold"
                                       Margin="6,8,0,2"/>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>

            <ListView.View>
                <GridView>
                    <GridViewColumn Width="34">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked}" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="" Width="24">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RecommendedMark}"
                                           Foreground="{StaticResource Accent}"
                                           ToolTip="Most likely main log"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="File" Width="230">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Candidate.FileName}"
                                           FontFamily="{StaticResource MonoFont}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Candidate.Path}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Folder" Width="280">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Candidate.Directory}"
                                           Foreground="{StaticResource TextSecondary}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Candidate.Directory}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Size" Width="70">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Candidate.SizeText}" TextAlignment="Right"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Last written" Width="130">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Candidate.LastWriteText}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Found via" Width="140">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Candidate.SourceText}"
                                           Foreground="{StaticResource TextSecondary}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Buttons -->
        <Grid Grid.Row="4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Select all" Command="{Binding SelectAllCommand}"
                        Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,8,0"/>
                <Button Content="None" Command="{Binding SelectNoneCommand}"
                        Style="{StaticResource SecondaryButton}" Padding="10,4"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                        Width="80" Click="Cancel_Click" IsCancel="True" Margin="0,0,8,0"/>
                <Button Content="{Binding OpenButtonText}" Style="{StaticResource PrimaryButton}"
                        MinWidth="120" Click="Open_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
