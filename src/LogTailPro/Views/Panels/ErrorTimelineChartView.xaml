<UserControl x:Class="LogTailPro.Views.ErrorTimelineChartView"
             x:Name="RootChartControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LogTailPro.Views"
             xmlns:conv="clr-namespace:LogTailPro.Converters"
             Background="{StaticResource BgElevated}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <DockPanel LastChildFill="True" Margin="8,6"
               DataContext="{Binding ElementName=RootChartControl, Path=ActiveChartViewModel}">
        <!-- ═══ 1. Summary Header ═══════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BgSurface}"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                CornerRadius="4" Padding="10,6" Margin="0,0,0,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Metadata & Severity Counters -->
                <DockPanel Grid.Row="0" LastChildFill="False">
                    <!-- Scope & Time Metadata -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Scope: " FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                        <TextBlock Text="{Binding SourceScope, FallbackValue='Log Stream'}"
                                   Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="11" Margin="0,0,14,0"/>

                        <TextBlock Text="Range: " FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                        <TextBlock Text="{Binding TimeRangeDescription, FallbackValue='No dated events'}"
                                   Foreground="{StaticResource TextPrimary}" FontSize="11" Margin="0,0,14,0"/>

                        <TextBlock Text="Bucket: " FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                        <TextBlock Text="{Binding BucketSizeDescription, FallbackValue='Auto'}"
                                   Foreground="{StaticResource TextPrimary}" FontSize="11" Margin="0,0,14,0"/>

                        <TextBlock Text="Timezone: " FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                        <TextBlock Text="{Binding TimezoneDescription, FallbackValue='Local'}"
                                   Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                    </StackPanel>

                    <!-- Severity Pills (Click to Toggle Layer) -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Total count -->
                        <Border Background="{StaticResource BgOverlay}" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                            <TextBlock Text="{Binding TotalEventCount, StringFormat='{}{0:N0} events', FallbackValue='0 events'}"
                                       Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="11"/>
                        </Border>

                        <!-- Error count toggle button -->
                        <Button Command="{Binding ToggleShowErrorsCommand}"
                                ToolTip="Click to show/hide Error layer in the chart"
                                Style="{StaticResource FlatToolbarButton}" Padding="0" Margin="0,0,6,0" Cursor="Hand">
                            <Border Background="{StaticResource BadgeErrorBg}" BorderBrush="{StaticResource StatusError}"
                                    BorderThickness="1" CornerRadius="3" Padding="6,2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowErrors}" Value="False">
                                                <Setter Property="Opacity" Value="0.45"/>
                                                <Setter Property="Background" Value="{StaticResource BgSurface}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✕ " FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextDisabled}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowErrors}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding ErrorCount, StringFormat='{}{0:N0} errors', FallbackValue='0 errors'}"
                                               Foreground="{StaticResource BadgeErrorFg}" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </Button>

                        <!-- Warning count toggle button -->
                        <Button Command="{Binding ToggleShowWarningsCommand}"
                                ToolTip="Click to show/hide Warning layer in the chart"
                                Style="{StaticResource FlatToolbarButton}" Padding="0" Margin="0,0,6,0" Cursor="Hand">
                            <Border Background="{StaticResource BadgeWarnBg}" BorderBrush="{StaticResource StatusWarn}"
                                    BorderThickness="1" CornerRadius="3" Padding="6,2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowWarnings}" Value="False">
                                                <Setter Property="Opacity" Value="0.45"/>
                                                <Setter Property="Background" Value="{StaticResource BgSurface}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✕ " FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextDisabled}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowWarnings}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding WarningCount, StringFormat='{}{0:N0} warnings', FallbackValue='0 warnings'}"
                                               Foreground="{StaticResource BadgeWarnFg}" FontWeight="SemiBold" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </Button>

                        <!-- Information count toggle button -->
                        <Button Command="{Binding ToggleShowInfosCommand}"
                                ToolTip="Click to show/hide Information layer in the chart"
                                Style="{StaticResource FlatToolbarButton}" Padding="0" Margin="0,0,6,0" Cursor="Hand">
                            <Border Background="{StaticResource BadgeInfoBg}" BorderBrush="{StaticResource Accent}"
                                    BorderThickness="1" CornerRadius="3" Padding="6,2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowInfos}" Value="False">
                                                <Setter Property="Opacity" Value="0.45"/>
                                                <Setter Property="Background" Value="{StaticResource BgSurface}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✕ " FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextDisabled}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowInfos}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding InfoCount, StringFormat='{}{0:N0} info', FallbackValue='0 info'}"
                                               Foreground="{StaticResource BadgeInfoFg}" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </Button>

                        <!-- Other count toggle button -->
                        <Button Command="{Binding ToggleShowOthersCommand}"
                                ToolTip="Click to show/hide Other layer in the chart"
                                Style="{StaticResource FlatToolbarButton}" Padding="0" Cursor="Hand">
                            <Border Background="{StaticResource BgOverlay}" BorderBrush="{StaticResource BorderNormal}"
                                    BorderThickness="1" CornerRadius="3" Padding="6,2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowOthers}" Value="False">
                                                <Setter Property="Opacity" Value="0.45"/>
                                                <Setter Property="Background" Value="{StaticResource BgSurface}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✕ " FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextDisabled}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowOthers}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding OtherCount, StringFormat='{}{0:N0} other', FallbackValue='0 other'}"
                                               Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- Row 1: Filter Banner & Undated Events Notice -->
                <DockPanel Grid.Row="1" Margin="0,4,0,0" LastChildFill="False">
                    <!-- Active Time-Range Filter Banner -->
                    <Border DockPanel.Dock="Left"
                            Visibility="{Binding HasTimeRangeFilter, Converter={StaticResource BoolToVisibility}}"
                            Background="{StaticResource AccentMuted}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                            CornerRadius="3" Padding="8,2" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⏱  " Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Text="{Binding SelectionSummary}"
                                       Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="11" Margin="0,0,8,0"/>
                            <Button Content="✕ Clear Filter"
                                    Command="{Binding ClearFilterCommand}"
                                    Style="{StaticResource FlatToolbarButton}"
                                    Padding="4,0" FontSize="10" Cursor="Hand"/>
                        </StackPanel>
                    </Border>

                    <!-- Undated events notice -->
                    <TextBlock DockPanel.Dock="Right"
                               Visibility="{Binding HasUndatedEvents, Converter={StaticResource BoolToVisibility}}"
                               Text="{Binding UndatedDescription}"
                               Foreground="{StaticResource TextSecondary}" FontStyle="Italic" FontSize="11" VerticalAlignment="Center"/>
                </DockPanel>
            </Grid>
        </Border>

        <!-- ═══ 2. Interactive Chart Canvas ═════════════════════════════════════ -->
        <Border Background="{StaticResource BgBase}" BorderBrush="{StaticResource BorderNormal}"
                BorderThickness="1" CornerRadius="4" Padding="6,4">
            <views:ErrorTimelineChartCanvas x:Name="ChartCanvas"
                                            Focusable="True"
                                            FocusVisualStyle="{x:Null}"/>
        </Border>
    </DockPanel>
</UserControl>
