<Window x:Class="LogTailPro.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LogTailPro.ViewModels"
        mc:Ignorable="d"
        Title="Settings" Height="400" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        d:DataContext="{d:DesignInstance Type={x:Type vm:SettingsViewModel}}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Sections ══ -->
        <StackPanel Grid.Row="1">

            <!-- Appearance -->
            <TextBlock Text="Appearance" FontWeight="Bold" Margin="0,0,0,8"/>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Font Family:" VerticalAlignment="Center" Padding="0"/>
                <ComboBox Grid.Column="1" SelectedValue="{Binding FontFamily}" SelectedValuePath="Content">
                    <ComboBoxItem Content="Consolas"/>
                    <ComboBoxItem Content="Courier New"/>
                    <ComboBoxItem Content="Lucida Console"/>
                    <ComboBoxItem Content="Cascadia Mono"/>
                    <ComboBoxItem Content="Fixedsys"/>
                </ComboBox>
            </Grid>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Font Size (pt):" VerticalAlignment="Center" Padding="0"/>
                <TextBox Grid.Column="1"
                         Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}"
                         Padding="4,3"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Label Content="Theme:" Width="140" VerticalAlignment="Center" Padding="0"/>
                <RadioButton Content="Dark"  IsChecked="{Binding IsDarkTheme}"  Margin="0,0,16,0" VerticalAlignment="Center"/>
                <RadioButton Content="Light" IsChecked="{Binding IsLightTheme}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Behaviour -->
            <TextBlock Text="Behaviour" FontWeight="Bold" Margin="0,0,0,8"/>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Max lines in memory:" VerticalAlignment="Center" Padding="0"/>
                <TextBox Grid.Column="1"
                         Text="{Binding MaxLinesInMemory, UpdateSourceTrigger=PropertyChanged}"
                         Padding="4,3"/>
            </Grid>

            <CheckBox Content="Follow tail when opening a new file"
                      IsChecked="{Binding FollowTailOnOpen}"
                      Margin="0,0,0,6"/>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Tab width (spaces):" VerticalAlignment="Center" Padding="0"/>
                <TextBox Grid.Column="1"
                         Text="{Binding TabWidth, UpdateSourceTrigger=PropertyChanged}"
                         Padding="4,3"/>
            </Grid>
        </StackPanel>

        <!-- ══ OK / Cancel ══ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK"     Width="80" Margin="0,0,8,0" IsDefault="True"  Click="OK_Click"/>
            <Button Content="Cancel" Width="80"                   IsCancel="True"   Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
