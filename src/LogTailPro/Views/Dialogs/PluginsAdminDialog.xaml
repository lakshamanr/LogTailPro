<Window x:Class="LogTailPro.Views.Dialogs.PluginsAdminDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plugins Manager — LogTailPro"
        Width="860" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgElevated}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource UiFont}"
        FontSize="{StaticResource UiSize}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Installed Plugins &amp; Extensions" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
            <TextBlock Text="LogTailPro automatically loads all plugins found in standard folders or your custom directories."
                       Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Plugins List + Load Log -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="140"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="1" CornerRadius="4">
                <ListView x:Name="PluginsListView" ItemsSource="{Binding LoadedPlugins}" BorderThickness="0"
                          Background="Transparent" Foreground="{StaticResource TextPrimary}"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Status" Width="70">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BadgeInfoBg}" CornerRadius="3" Padding="4,1">
                                            <TextBlock Text="Active" Foreground="{StaticResource BadgeInfoFg}" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Plugin Name" Width="180">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Version" Width="65">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Version}" Foreground="{StaticResource TextMuted}" FontFamily="{StaticResource MonoFont}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Author" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Author}" Foreground="{StaticResource TextSecondary}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Directory Path" Width="260">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DirectoryPath}" ToolTip="{Binding DirectoryPath}" Foreground="{StaticResource TextMuted}" FontFamily="{StaticResource MonoFont}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Action" Width="75">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remove" Click="RemoveRow_Click"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="6,2" FontSize="11"
                                                ToolTip="Remove this extension from LogTailPro"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="{StaticResource BorderSubtle}"/>

            <!-- Plugin Load Log -->
            <Border Grid.Row="2" Background="{StaticResource BgBase}" BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="1" CornerRadius="4" Margin="0,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Plugin Load Log" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMuted}" Margin="8,4,0,2"/>
                    <ListBox Grid.Row="1" x:Name="LoadLogList" ItemsSource="{Binding LoadLog}" BorderThickness="0"
                             Background="Transparent" Foreground="{StaticResource TextPrimary}"
                             FontFamily="{StaticResource MonoFont}" FontSize="11"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Actions -->
        <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
            <Button Content="Add Plugin / Folder…" Click="AddFolder_Click" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,8,0"/>
            <Button x:Name="RemoveBtn" Content="Remove Extension" Click="RemoveSelected_Click" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,8,0" IsEnabled="False"/>
            <Button Content="Open Plugins Folder" Click="OpenFolder_Click" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="Reload All" Click="Reload_Click" Style="{StaticResource SecondaryButton}" Padding="12,6"/>

            <Button DockPanel.Dock="Right" Content="Close" Click="Close_Click" Style="{StaticResource PrimaryButton}" Padding="18,6"/>
        </DockPanel>
    </Grid>
</Window>
