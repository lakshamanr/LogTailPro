<UserControl x:Class="LogTailPro.Views.StatsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LogTailPro.Converters"
             Background="{StaticResource BgElevated}">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>
    <UniformGrid Columns="2" Margin="12,10">
        <StackPanel Margin="0,0,8,10">
            <TextBlock Text="ERRORS" Foreground="{StaticResource TextSecondary}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding SelectedTab.StatsErrorCount, FallbackValue=0}" Foreground="{StaticResource StatusError}" FontSize="24" FontWeight="SemiBold"/>
        </StackPanel>
        <StackPanel Margin="0,0,0,10">
            <TextBlock Text="WARNINGS" Foreground="{StaticResource TextSecondary}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding SelectedTab.StatsWarnCount, FallbackValue=0}" Foreground="{StaticResource StatusWarn}" FontSize="24" FontWeight="SemiBold"/>
        </StackPanel>
        <StackPanel Margin="0,0,8,0">
            <TextBlock Text="INFO" Foreground="{StaticResource TextSecondary}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding SelectedTab.StatsInfoCount, FallbackValue=0}" Foreground="{StaticResource Accent}" FontSize="24" FontWeight="SemiBold"/>
        </StackPanel>
        <StackPanel>
            <TextBlock Text="LINES / SEC" Foreground="{StaticResource TextSecondary}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding SelectedTab.StatsLinesPerSecond, FallbackValue=0}" Foreground="{StaticResource StatusGreen}" FontSize="24" FontWeight="SemiBold"/>
        </StackPanel>
    </UniformGrid>
</UserControl>
