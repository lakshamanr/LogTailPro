<UserControl x:Class="LogTailPro.Views.LogTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:LogTailPro.Converters"
             xmlns:vm="clr-namespace:LogTailPro.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type={x:Type vm:LogTabViewModel}}">

    <UserControl.Resources>
        <conv:HighlightColorConverter          x:Key="HighlightColorConverter"/>
        <conv:BoolToVisibilityConverter        x:Key="BoolToVisibilityConverter"/>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter"/>
    </UserControl.Resources>

    <!-- Outer Grid lets the loading overlay float on top -->
    <Grid>

        <DockPanel LastChildFill="True">

            <!-- Warning banner (file deleted / truncated) -->
            <Border DockPanel.Dock="Top"
                    Background="#8B0000"
                    Padding="8,4"
                    Visibility="{Binding WarningMessage,
                                 Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                <TextBlock Text="{Binding WarningMessage}"
                           Foreground="White"
                           FontWeight="Bold"/>
            </Border>

            <!-- Stats panel (Ctrl+Shift+S) -->
            <Border DockPanel.Dock="Bottom"
                    Background="{StaticResource BgElevated}"
                    BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="0,1,0,0"
                    Height="24"
                    Visibility="{Binding IsStatsPanelVisible,
                                 Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                    <TextBlock Text="ERR" Foreground="{StaticResource StatusError}"  FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StatsErrorCount}" Foreground="{StaticResource StatusError}"  FontFamily="Segoe UI" FontSize="11" Margin="3,0,12,0"/>
                    <TextBlock Text="WARN" Foreground="{StaticResource StatusWarn}"  FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StatsWarnCount}" Foreground="{StaticResource StatusWarn}"  FontFamily="Segoe UI" FontSize="11" Margin="3,0,12,0"/>
                    <TextBlock Text="INFO" Foreground="{StaticResource TextSecondary}" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StatsInfoCount}" Foreground="{StaticResource TextSecondary}" FontFamily="Segoe UI" FontSize="11" Margin="3,0,12,0"/>
                    <TextBlock Text="lines/s" Foreground="{StaticResource TextMuted}" FontFamily="Segoe UI" FontSize="11"/>
                    <TextBlock Text="{Binding StatsLinesPerSecond}" Foreground="{StaticResource TextPrimary}" FontFamily="Segoe UI" FontSize="11" Margin="3,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- Pretty-print / detail panel (Ctrl+P) -->
            <Border DockPanel.Dock="Bottom"
                    Background="{StaticResource BgElevated}"
                    BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="0,1,0,0"
                    MaxHeight="220"
                    Visibility="{Binding IsDetailPanelVisible,
                                 Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="6,4">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="Detail View"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <Button DockPanel.Dock="Right"
                                Content="x"
                                Command="{Binding CloseDetailPanelCommand}"
                                Padding="6,1"
                                Margin="4,0,0,0"
                                ToolTip="Close detail panel"/>
                    </DockPanel>
                    <TextBox Grid.Row="1"
                             Text="{Binding DetailText, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             FontFamily="Consolas"
                             FontSize="11"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="6,0,6,6"/>
                </Grid>
            </Border>

            <!-- ── Log ListView — colors driven by theme tokens ── -->
            <ListView x:Name="LogListView"
                      Background="{StaticResource BgLog}"
                      Foreground="{StaticResource TextLog}"
                      BorderThickness="0"
                      FontFamily="Consolas"
                      FontSize="13"
                      ItemsSource="{Binding VisibleLines}"
                      SelectedItem="{Binding SelectedLogLine, Mode=TwoWay}"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.CacheLengthUnit="Item"
                      VirtualizingPanel.CacheLength="200,200"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      SelectionMode="Extended"
                      SelectionChanged="LogListView_SelectionChanged">

                <ListView.Resources>
                    <!-- Completely hide column headers -->
                    <Style TargetType="GridViewColumnHeader">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Height"     Value="0"/>
                    </Style>
                    <!-- Thin scrollbar — theme-aware -->
                    <Style TargetType="ScrollBar">
                        <Setter Property="Width"    Value="6"/>
                        <Setter Property="MinWidth" Value="6"/>
                        <Setter Property="Background" Value="{StaticResource BgElevated}"/>
                    </Style>
                </ListView.Resources>

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="FontFamily"
                                Value="{Binding DataContext.Settings.FontFamily,
                                        RelativeSource={RelativeSource AncestorType=Window},
                                        FallbackValue='Consolas'}"/>
                        <Setter Property="FontSize"
                                Value="{Binding DataContext.Settings.FontSize,
                                        RelativeSource={RelativeSource AncestorType=Window},
                                        FallbackValue='13'}"/>
                        <Setter Property="Padding"         Value="4,1"/>
                        <Setter Property="Margin"          Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <!-- Highlight rule colors -->
                        <Setter Property="Background"
                                Value="{Binding MatchedRule,
                                        Converter={StaticResource HighlightColorConverter},
                                        ConverterParameter=Background}"/>
                        <Setter Property="Foreground"
                                Value="{Binding MatchedRule,
                                        Converter={StaticResource HighlightColorConverter},
                                        ConverterParameter=Foreground}"/>
                        <Style.Triggers>
                            <!-- No rule → default log text color -->
                            <DataTrigger Binding="{Binding MatchedRule}" Value="{x:Null}">
                                <Setter Property="Foreground" Value="{StaticResource TextLog}"/>
                            </DataTrigger>
                            <!-- Search match highlight -->
                            <DataTrigger Binding="{Binding IsSearchMatch}" Value="True">
                                <Setter Property="Background" Value="{StaticResource SearchMatchBg}"/>
                                <Setter Property="Foreground" Value="{StaticResource SearchMatchFg}"/>
                            </DataTrigger>
                            <!-- Selected row -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource BgLogSelected}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <!-- Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BgLogHover}"/>
                                <Setter Property="Cursor"     Value="IBeam"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.InputBindings>
                    <KeyBinding Key="C" Modifiers="Ctrl"
                                Command="{Binding CopySelectedLinesCommand}"/>
                </ListView.InputBindings>

                <!-- Gutter columns + content column -->
                <ListView.View>
                    <GridView>
                        <!-- Bookmark dot gutter (8px) -->
                        <GridViewColumn Width="14">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Ellipse Width="6" Height="6"
                                             Fill="{StaticResource Accent}"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Center"
                                             Visibility="{Binding IsBookmarked,
                                                          Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <!-- Line number gutter (52px) -->
                        <GridViewColumn Width="52">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LineNumber}"
                                               TextAlignment="Right"
                                               Foreground="{StaticResource TextMuted}"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               Padding="0,0,6,0"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <!-- Elapsed/timestamp column (hidden when ShowElapsedColumn=false) -->
                        <GridViewColumn Width="{Binding DataContext.ElapsedColumnWidth,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ElapsedSincePrevious, StringFormat='+{0:hh\\:mm\\:ss\\.fff}'}"
                                               Foreground="{StaticResource TextMuted}"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               ToolTip="{Binding Timestamp}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <!-- Content column -->
                        <GridViewColumn Width="4000">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}"
                                               FontFamily="Consolas"
                                               FontSize="13">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="NoWrap"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsLineWrapEnabled,
                                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                 Value="True">
                                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>

            </ListView>

        </DockPanel>

        <!-- Loading overlay — floats above everything -->
        <Grid Background="#CC000000"
              Visibility="{Binding IsLoading,
                           Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Loading file..."
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="14"
                           FontFamily="Segoe UI"
                           HorizontalAlignment="Center"/>
                <ProgressBar Value="{Binding LoadProgress}"
                             Maximum="100"
                             Width="280" Height="4"
                             Margin="0,16,0,0"
                             Background="{StaticResource BgSurface}"
                             Foreground="{StaticResource Accent}"
                             BorderThickness="0"/>
                <TextBlock Text="{Binding LoadProgress, StringFormat='{}{0}%'}"
                           Foreground="{StaticResource TextSecondary}"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
