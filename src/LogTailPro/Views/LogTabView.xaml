<UserControl x:Class="LogTailPro.Views.LogTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:LogTailPro.Converters"
             xmlns:vm="clr-namespace:LogTailPro.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type={x:Type vm:LogTabViewModel}}">

    <UserControl.Resources>
        <conv:HighlightColorConverter          x:Key="HighlightColorConverter"/>
        <conv:BoolToVisibilityConverter        x:Key="BoolToVisibilityConverter"/>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter"/>
    </UserControl.Resources>

    <!-- Outer Grid lets the loading overlay float on top -->
    <Grid>

        <DockPanel LastChildFill="True">

            <!-- Warning banner (file deleted / truncated) -->
            <Border DockPanel.Dock="Top"
                    Background="#8B0000"
                    Padding="8,4"
                    Visibility="{Binding WarningMessage,
                                 Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                <TextBlock Text="{Binding WarningMessage}"
                           Foreground="White"
                           FontWeight="Bold"/>
            </Border>

            <!-- Pretty-print / detail panel (Ctrl+P) -->
            <Border DockPanel.Dock="Bottom"
                    Background="{StaticResource BgElevated}"
                    BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="0,1,0,0"
                    MaxHeight="220"
                    Visibility="{Binding IsDetailPanelVisible,
                                 Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="6,4">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="Detail View"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <Button DockPanel.Dock="Right"
                                Content="x"
                                Command="{Binding CloseDetailPanelCommand}"
                                Padding="6,1"
                                Margin="4,0,0,0"
                                ToolTip="Close detail panel"/>
                    </DockPanel>
                    <TextBox Grid.Row="1"
                             Text="{Binding DetailText, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             FontFamily="Consolas"
                             FontSize="11"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="6,0,6,6"/>
                </Grid>
            </Border>

            <!-- ── Log ListView — pure black bg, single full-width content column ── -->
            <ListView x:Name="LogListView"
                      Background="#000000"
                      Foreground="#5A9A5A"
                      BorderThickness="0"
                      FontFamily="Consolas"
                      FontSize="13"
                      ItemsSource="{Binding VisibleLines}"
                      SelectedItem="{Binding SelectedLogLine, Mode=TwoWay}"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.CacheLengthUnit="Item"
                      VirtualizingPanel.CacheLength="200,200"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      SelectionMode="Extended"
                      SelectionChanged="LogListView_SelectionChanged">

                <ListView.Resources>
                    <!-- Completely hide column headers -->
                    <Style TargetType="GridViewColumnHeader">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Height"     Value="0"/>
                    </Style>
                    <!-- Thin dark scrollbar -->
                    <Style TargetType="ScrollBar">
                        <Setter Property="Width"    Value="6"/>
                        <Setter Property="MinWidth" Value="6"/>
                        <Setter Property="Background" Value="#1A1A2A"/>
                    </Style>
                </ListView.Resources>

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="FontFamily"
                                Value="{Binding DataContext.Settings.FontFamily,
                                        RelativeSource={RelativeSource AncestorType=Window},
                                        FallbackValue='Consolas'}"/>
                        <Setter Property="FontSize"
                                Value="{Binding DataContext.Settings.FontSize,
                                        RelativeSource={RelativeSource AncestorType=Window},
                                        FallbackValue='13'}"/>
                        <Setter Property="Padding"         Value="4,1"/>
                        <Setter Property="Margin"          Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <!-- Highlight rule colors -->
                        <Setter Property="Background"
                                Value="{Binding MatchedRule,
                                        Converter={StaticResource HighlightColorConverter},
                                        ConverterParameter=Background}"/>
                        <Setter Property="Foreground"
                                Value="{Binding MatchedRule,
                                        Converter={StaticResource HighlightColorConverter},
                                        ConverterParameter=Foreground}"/>
                        <Style.Triggers>
                            <!-- No rule → default green on black -->
                            <DataTrigger Binding="{Binding MatchedRule}" Value="{x:Null}">
                                <Setter Property="Foreground" Value="#5A9A5A"/>
                            </DataTrigger>
                            <!-- Search match highlight -->
                            <DataTrigger Binding="{Binding IsSearchMatch}" Value="True">
                                <Setter Property="Background" Value="#3D2B00"/>
                                <Setter Property="Foreground" Value="#FFD080"/>
                            </DataTrigger>
                            <!-- Selected row -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1A2A4A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <!-- Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0F0F20"/>
                                <Setter Property="Cursor"     Value="IBeam"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.InputBindings>
                    <KeyBinding Key="C" Modifiers="Ctrl"
                                Command="{Binding CopySelectedLinesCommand}"/>
                </ListView.InputBindings>

                <!-- Single full-width content column — no line numbers, no bookmark gutter -->
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="4000">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}"
                                               FontFamily="Consolas"
                                               FontSize="13">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="NoWrap"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsLineWrapEnabled,
                                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                 Value="True">
                                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>

            </ListView>

        </DockPanel>

        <!-- Loading overlay — floats above everything -->
        <Grid Background="#CC000000"
              Visibility="{Binding IsLoading,
                           Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Loading file..."
                           Foreground="#AAAAAA"
                           FontSize="14"
                           FontFamily="Segoe UI"
                           HorizontalAlignment="Center"/>
                <ProgressBar Value="{Binding LoadProgress}"
                             Maximum="100"
                             Width="280" Height="4"
                             Margin="0,16,0,0"
                             Background="#2A2A3A"
                             Foreground="#0078D4"
                             BorderThickness="0"/>
                <TextBlock Text="{Binding LoadProgress, StringFormat='{}{0}%'}"
                           Foreground="#888899"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
