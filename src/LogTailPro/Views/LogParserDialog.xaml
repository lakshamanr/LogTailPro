<Window x:Class="LogTailPro.Views.LogParserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LogTailPro.ViewModels"
        mc:Ignorable="d"
        Title="Configure Log Parser"
        Height="500" Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinHeight="400" MinWidth="500"
        d:DataContext="{d:DesignInstance Type={x:Type vm:LogParserViewModel}}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Preset selector -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="Preset:" VerticalAlignment="Center" Padding="0"/>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Presets}"
                      SelectedItem="{Binding SelectedPreset}"
                      DisplayMemberPath="Name"/>
        </Grid>

        <!-- Pattern -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="Pattern:" VerticalAlignment="Top" Padding="0" Margin="0,4,0,0"/>
            <TextBox Grid.Column="1"
                     Text="{Binding CustomPattern, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap" AcceptsReturn="False"
                     Height="60" Padding="4,3" VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="11"
                     ToolTip="Named groups: (?&lt;Timestamp&gt;…) (?&lt;Level&gt;…) (?&lt;Thread&gt;…) (?&lt;Class&gt;…) (?&lt;Message&gt;…)"/>
        </Grid>

        <!-- Sample line test -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="Sample line:" VerticalAlignment="Center" Padding="0"/>
            <TextBox Grid.Column="1"
                     Text="{Binding SampleLine, UpdateSourceTrigger=PropertyChanged}"
                     Padding="4,3" FontFamily="Consolas" FontSize="11"
                     ToolTip="Paste a sample log line to test the pattern"/>
        </Grid>

        <!-- Parse result -->
        <GroupBox Grid.Row="3" Header="Parse result" Margin="0,0,0,8">
            <TextBox Text="{Binding ParseResult, Mode=OneWay}"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     FontFamily="Consolas" FontSize="11"
                     VerticalScrollBarVisibility="Auto"
                     Background="Transparent"
                     BorderThickness="0"/>
        </GroupBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Clear (disable parser)" Width="150" Margin="0,0,8,0" Click="Clear_Click"/>
            <Button Content="OK"     Width="75" Margin="0,0,8,0" IsDefault="True" Click="OK_Click"/>
            <Button Content="Cancel" Width="75" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
