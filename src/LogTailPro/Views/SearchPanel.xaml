<UserControl x:Class="LogTailPro.Views.SearchPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:LogTailPro.Converters"
             xmlns:vm="clr-namespace:LogTailPro.ViewModels"
             xmlns:models="clr-namespace:LogTailPro.Models"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type={x:Type vm:LogTabViewModel}}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter"/>

        <Style x:Key="ToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource TabBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding"    Value="6,2"/>
            <Setter Property="Margin"     Value="2,0"/>
            <Setter Property="MinWidth"   Value="28"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SearchButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource TabBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding"    Value="6,2"/>
            <Setter Property="Margin"     Value="2,0"/>
            <Setter Property="MinWidth"   Value="28"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource SearchBarBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">
        <StackPanel>

            <!-- ── Primary search row ── -->
            <Grid Margin="6,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>   <!-- "Find:" label -->
                    <ColumnDefinition Width="280"/>    <!-- search box -->
                    <ColumnDefinition Width="Auto"/>   <!-- .* regex toggle -->
                    <ColumnDefinition Width="Auto"/>   <!-- Aa case toggle -->
                    <ColumnDefinition Width="Auto"/>   <!-- filter mode combo -->
                    <ColumnDefinition Width="Auto"/>   <!-- match count -->
                    <ColumnDefinition Width="Auto"/>   <!-- ▲ prev -->
                    <ColumnDefinition Width="Auto"/>   <!-- ▼ next -->
                    <ColumnDefinition Width="*"/>      <!-- spacer -->
                    <ColumnDefinition Width="Auto"/>   <!-- [+ Filter] -->
                    <ColumnDefinition Width="Auto"/>   <!-- ✕ close -->
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Content="Find:" VerticalAlignment="Center"
                       Foreground="{StaticResource ForegroundBrush}" Padding="0,0,4,0"/>

                <!-- Search TextBox — red border on error -->
                <Border Grid.Column="1" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchError,
                                             Converter={StaticResource StringNotEmptyToVisibilityConverter}}"
                                             Value="Visible">
                                    <Setter Property="BorderBrush" Value="#CC3333"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource SearchBarBrush}"
                             Foreground="{StaticResource ForegroundBrush}"
                             CaretBrush="{StaticResource ForegroundBrush}"
                             BorderThickness="0"
                             Padding="4,3"
                             VerticalAlignment="Center"
                             ToolTip="{Binding SearchError}"
                             KeyDown="SearchBox_KeyDown"/>
                </Border>

                <!-- Regex toggle -->
                <ToggleButton Grid.Column="2"
                              Content=".*"
                              IsChecked="{Binding IsRegexMode}"
                              Style="{StaticResource ToggleButtonStyle}"
                              ToolTip="Use regular expression (Alt+R)"/>

                <!-- Case-sensitive toggle -->
                <ToggleButton Grid.Column="3"
                              Content="Aa"
                              IsChecked="{Binding IsCaseSensitive}"
                              Style="{StaticResource ToggleButtonStyle}"
                              ToolTip="Match case (Alt+C)"/>

                <!-- Filter mode selector -->
                <ComboBox Grid.Column="4"
                          Margin="4,0"
                          VerticalAlignment="Center"
                          SelectedIndex="0">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox">
                            <Setter Property="Background" Value="{StaticResource TabBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                            <Setter Property="Padding"     Value="4,2"/>
                        </Style>
                    </ComboBox.Style>
                    <ComboBoxItem Content="Highlight only" Tag="None"
                                  Selected="FilterModeItem_Selected"/>
                    <ComboBoxItem Content="Show only matching" Tag="IncludeMatching"
                                  Selected="FilterModeItem_Selected"/>
                    <ComboBoxItem Content="Hide matching" Tag="ExcludeMatching"
                                  Selected="FilterModeItem_Selected"/>
                </ComboBox>

                <!-- Match count -->
                <TextBlock Grid.Column="5"
                           VerticalAlignment="Center"
                           Margin="8,0"
                           Foreground="{StaticResource ForegroundBrush}"
                           Opacity="0.7">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text"
                                    Value="{Binding MatchCount, StringFormat='{}{0} matches'}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                    <Setter Property="Text" Value=""/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Previous match -->
                <Button Grid.Column="6"
                        Content="▲"
                        Style="{StaticResource SearchButtonStyle}"
                        Command="{Binding PreviousMatchCommand}"
                        ToolTip="Previous match (Shift+F3)"/>

                <!-- Next match -->
                <Button Grid.Column="7"
                        Content="▼"
                        Style="{StaticResource SearchButtonStyle}"
                        Command="{Binding NextMatchCommand}"
                        ToolTip="Next match (F3)"/>

                <!-- Add filter rule -->
                <Button Grid.Column="9"
                        Content="+ Filter"
                        Style="{StaticResource SearchButtonStyle}"
                        Command="{Binding AddFilterRuleCommand}"
                        ToolTip="Add an AND/OR/NOT filter rule"/>

                <!-- Close search panel -->
                <Button Grid.Column="10"
                        Content="✕"
                        Style="{StaticResource SearchButtonStyle}"
                        Command="{Binding CloseSearchCommand}"
                        ToolTip="Close (Escape)"/>
            </Grid>

            <!-- Error text -->
            <TextBlock Text="{Binding SearchError}"
                       Foreground="#CC3333"
                       Margin="70,0,6,4"
                       FontSize="11"
                       Visibility="{Binding SearchError,
                                   Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>

            <!-- ── Filter chain rows ── -->
            <ItemsControl ItemsSource="{Binding FilterRules}"
                          Visibility="{Binding FilterRules.Count,
                                       Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:FilterRuleViewModel}">
                        <Border BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="6,3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>  <!-- AND/OR toggle -->
                                    <ColumnDefinition Width="Auto"/>  <!-- NOT toggle -->
                                    <ColumnDefinition Width="*"/>     <!-- pattern box -->
                                    <ColumnDefinition Width="Auto"/>  <!-- .* regex -->
                                    <ColumnDefinition Width="Auto"/>  <!-- Aa case -->
                                    <ColumnDefinition Width="Auto"/>  <!-- enabled -->
                                    <ColumnDefinition Width="Auto"/>  <!-- ✕ remove -->
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="{Binding OperatorLabel}"
                                        Command="{Binding ToggleOperatorCommand}"
                                        Style="{StaticResource SearchButtonStyle}"
                                        ToolTip="Toggle AND / OR"/>

                                <ToggleButton Grid.Column="1"
                                             Content="NOT"
                                             IsChecked="{Binding IsNegated}"
                                             Style="{StaticResource ToggleButtonStyle}"
                                             ToolTip="Negate this rule"/>

                                <TextBox Grid.Column="2"
                                         Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{StaticResource SearchBarBrush}"
                                         Foreground="{StaticResource ForegroundBrush}"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         Padding="4,2"
                                         Margin="4,0"/>

                                <ToggleButton Grid.Column="3"
                                             Content=".*"
                                             IsChecked="{Binding IsRegex}"
                                             Style="{StaticResource ToggleButtonStyle}"
                                             ToolTip="Use regular expression"/>

                                <ToggleButton Grid.Column="4"
                                             Content="Aa"
                                             IsChecked="{Binding IsCaseSensitive}"
                                             Style="{StaticResource ToggleButtonStyle}"
                                             ToolTip="Match case"/>

                                <CheckBox Grid.Column="5"
                                          IsChecked="{Binding IsEnabled}"
                                          VerticalAlignment="Center"
                                          Margin="6,0"
                                          ToolTip="Enable/disable this rule"/>

                                <Button Grid.Column="6"
                                        Content="✕"
                                        Command="{Binding RemoveCommand}"
                                        Style="{StaticResource SearchButtonStyle}"
                                        ToolTip="Remove this rule"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </Border>
</UserControl>
